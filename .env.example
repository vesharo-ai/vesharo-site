# Vesharo Production & Development Environment Variables

# Site Configuration
PUBLIC_SITE_URL=https://vesharo.com

# Privacy-Friendly Analytics (VS-24)
# Preferred cookieless option: Plausible Analytics (requires no cookie consent banner)
PUBLIC_PLAUSIBLE_DOMAIN=vesharo.com
PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# Alternative cookieless option: Umami Analytics
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Traditional analytics: Google Analytics 4 (only if required)
PUBLIC_GA_ID=

# Search Engine Webmaster Verification (VS-24)
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Contact Form Backend & Email Delivery (VS-25)
# Email delivery target: defaults to vesharo.ai@gmail.com
CONTACT_TO=vesharo.ai@gmail.com
CONTACT_FROM=Vesharo Inquiries <leads@vesharo.com>

# Resend API Key for serverless transactional email delivery
# Obtain from https://resend.com/api-keys
# If left empty in local dev, API endpoint runs in safe mock mode without throwing errors
RESEND_API_KEY=
