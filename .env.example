# ---------------------------------------------------------------------------
# Vesharo environment variables
#
# Copy to `.env` for local development and set the same values in your host's
# dashboard for production. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Free Lead Capture / Quote Form Services -----------------------------
# Option A: Web3Forms (Free 250 submissions/mo, no backend needed, emails contact@vesharo.com)
# Get a free access key at https://web3forms.com
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Option B: Formspree endpoint (optional)
PUBLIC_FORMSPREE_ENDPOINT=

# Option C: Direct Resend API (used by /api/contact when Web3Forms key is not provided)
RESEND_API_KEY=re_your_api_key_here
LEAD_FROM_EMAIL=Vesharo Website <onboarding@resend.dev>

# --- Booking & Scheduling (Cal.com / Calendly) -----------------------------
# When set, "Book a call" buttons appear across the site. If empty, CTAs default to Quote form & WhatsApp.
PUBLIC_BOOKING_URL=

# --- Cloudflare Web Analytics, GA4 or Turnstile (optional) -----------------
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_TURNSTILE_SITEKEY=