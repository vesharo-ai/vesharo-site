---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb";
import BlogPage from "@/components/blog/BlogPage";
import CtaBand from "@/components/cta/CtaBand";
import { getBlogPosts } from "@/lib/blog";
---

<Layout
  title="Engineering Blog | Vesharo"
  description="Practical engineering notes from Vesharo on architecture, cloud migration, data platforms, and product design."
>
  <BreadCrumb client:load title="Engineering Blog" />
  <BlogPage
    client:visible
    blogData={await getBlogPosts()}
    backgroundColor="#0f0f0f"
  />
  <CtaBand
    client:visible
    kicker="Next step"
    heading="Reading about it is not the same as scoping it"
    body="These articles describe how we think about a problem. If you have one of these problems right now, the useful next step is to tell us the specifics — the constraint, the deadline, what is already in place."
    label="Discuss Your Project"
    secondaryLabel="See what we build"
    secondaryHref="/services"
  />
</Layout>
