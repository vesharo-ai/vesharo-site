---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb.astro";
import HeaderSlider from "@/components/heading-slider/HeaderSlider";
import BlogPage from "@/components/blog/BlogPage.astro";
import Subscribe1 from "@/components/subscribe/Subscribe1.astro";
---

<Layout
  title="Engineering Blog & Insights | Vesharo"
  description="Technical articles and insights on production AI engineering, LLM orchestration, cloud architectures, and software scale."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog" },
  ]}
>
  <BreadCrumb title="Blog" />
  <HeaderSlider />
  <BlogPage backgroundColor="#0b0f19" />
  <Subscribe1 />
</Layout>
