---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb.astro";
import HeaderSlider from "@/components/heading-slider/HeaderSlider";
import Subscribe1 from "@/components/subscribe/Subscribe1.astro";
---

<Layout
  title="Cookie Policy | Vesharo"
  description="Understand how Vesharo utilizes essential storage and functional cookies to provide an optimized, fast website experience."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Cookie Policy", path: "/cookies" },
  ]}
>
  <BreadCrumb title="Cookie Policy" />
  <HeaderSlider />

  <section class="py-5" style="background-color: #0b0f19;">
    <div class="container py-lg-4">
      <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
          <div class="p-4 p-md-5 rounded-4" style="background-color: #0f1626; border: 1px solid rgba(255, 255, 255, 0.08);">
            <div class="mb-4">
              <span class="badge px-3 py-2 rounded-pill text-primary" style="background-color: rgba(0, 102, 255, 0.12); font-size: 0.875rem;">
                Last Updated: October 2026
              </span>
            </div>

            <h1 class="h2 text-white mb-4 fw-bold">Cookie Policy</h1>
            <p class="text-white-50 lead mb-5">
              Vesharo believes in building lightweight, high-performance web applications that respect your digital footprint. This Cookie Policy explains our minimal use of cookies and local storage on vesharo.com.
            </p>

            <div class="mb-5">
              <h2 class="h4 text-white fw-semibold mb-3">1. What Are Cookies & Local Storage?</h2>
              <p class="text-white-50 mb-3">
                Cookies and browser local storage are small text files stored on your device by websites you visit. They are commonly used to remember preferences, authenticate sessions, and deliver efficient user experiences.
              </p>
            </div>

            <div class="mb-5">
              <h2 class="h4 text-white fw-semibold mb-3">2. How Vesharo Uses Browser Storage</h2>
              <p class="text-white-50 mb-3">
                We maintain an ultra-strict privacy profile:
              </p>
              <ul class="text-white-50 ps-4 mb-3">
                <li class="mb-2"><strong class="text-white">Strictly Functional Storage:</strong> We use browser <code>localStorage</code> solely to remember your UI display preference (<code>vesharo-theme</code>: light or dark mode) to prevent flashing unstyled themes when you navigate between pages.</li>
                <li class="mb-2"><strong class="text-white">Zero Invasive Ad Trackers:</strong> We do not deploy third-party advertising cookies, retargeting pixels, or behavioral marketing trackers.</li>
                <li class="mb-2"><strong class="text-white">No Cross-Site Surveillance:</strong> We do not track your browsing activity across other websites.</li>
              </ul>
            </div>

            <div class="mb-5">
              <h2 class="h4 text-white fw-semibold mb-3">3. Managing Your Browser Storage</h2>
              <p class="text-white-50 mb-3">
                You can configure your browser at any time to block or delete cookies and local storage data:
              </p>
              <ul class="text-white-50 ps-4 mb-3">
                <li class="mb-2"><strong class="text-white">Google Chrome:</strong> Settings → Privacy and Security → Clear Browsing Data → Cookies and other site data.</li>
                <li class="mb-2"><strong class="text-white">Mozilla Firefox:</strong> Settings → Privacy & Security → Cookies and Site Data → Clear Data.</li>
                <li class="mb-2"><strong class="text-white">Apple Safari:</strong> Preferences → Privacy → Manage Website Data → Remove All.</li>
              </ul>
              <p class="text-white-50">
                Disabling local storage will reset your light/dark theme preference to default, but will not prevent you from browsing any content on the site.
              </p>
            </div>

            <div>
              <h2 class="h4 text-white fw-semibold mb-3">4. Inquiries</h2>
              <p class="text-white-50 mb-0">
                If you have questions regarding our cookie practices, reach out to us at <a href="mailto:contact@vesharo.com" class="text-primary text-decoration-none">contact@vesharo.com</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Subscribe1 spacingClass="tz-mt-lg-80" />
</Layout>
