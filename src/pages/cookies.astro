---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb.astro";
import HeaderSlider from "@/components/heading-slider/HeaderSlider";
import Subscribe1 from "@/components/subscribe/Subscribe1.astro";
---

<Layout
  title="Cookie Policy | Cookieless Analytics & Storage | Vesharo"
  description="How Vesharo uses lightweight functional browser storage and cookieless metrics. Zero third-party ad trackers, zero surveillance."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Cookie Policy", path: "/cookies" },
  ]}
>
  <BreadCrumb title="Cookie Policy" />
  <HeaderSlider />

  <section class="py-5" style="background-color: var(--vesharo-navy-base, #070B14); color: #fff;">
    <div class="container py-lg-4">
      <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
          <div class="p-4 p-md-5 rounded-4" style="background-color: rgba(11, 15, 25, 0.9); border: 1px solid rgba(255, 255, 255, 0.08);">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
              <span class="badge px-3 py-2 rounded-pill text-cyan" style="background-color: rgba(0, 210, 255, 0.1); border: 1px solid rgba(0, 210, 255, 0.25); color: var(--vesharo-electric-accent, #00d2ff); font-size: 0.875rem;">
                Last Updated: October 2026
              </span>
              <span class="tz-text-xs text-neutral-400" style="color: #64748B;">
                Zero Invasive Tracking Cookies Deployed
              </span>
            </div>

            <h1 class="h2 text-white mb-4 fw-bold" style="font-family: var(--font-family-heading);">
              Cookie & Local Storage Policy
            </h1>
            <p class="text-neutral-300 lead mb-5" style="color: #CBD5E1; line-height: 1.7;">
              Vesharo believes in engineering high-velocity websites that respect your digital sovereignty. We do not use third-party marketing cookies, behavioral tracking pixels, or cross-site fingerprinting scripts.
            </p>

            <div class="mb-5">
              <h2 class="h4 text-white fw-semibold mb-3" style="font-family: var(--font-family-heading);">
                1. What Storage Technologies Do We Use?
              </h2>
              <p class="text-neutral-300 mb-3" style="color: #94A3B8;">
                Our site uses minimal browser client-side storage strictly necessary for basic functionality:
              </p>
              <ul class="text-neutral-300 ps-4 mb-3" style="color: #CBD5E1; line-height: 1.8;">
                <li class="mb-2">
                  <strong class="text-white">Functional Theme Preference (localStorage):</strong> We store your preferred display theme (<code>vesharo-theme</code>: light or dark) in your browser's local storage. This ensures the site renders smoothly in your chosen theme without layout shifts or flashing.
                </li>
                <li class="mb-2">
                  <strong class="text-white">Zero Non-Essential Marketing Cookies:</strong> We do not set third-party marketing, retargeting, or advertising cookies. Because no personal data is tracked or shared with ad networks, no intrusive cookie consent banner is required under GDPR and ePrivacy regulations.
                </li>
                <li class="mb-2">
                  <strong class="text-white">Cookieless Analytics:</strong> Any performance analytics we evaluate are collected in aggregate without cookies, IP geolocation fingerprinting, or cross-session tracking.
                </li>
              </ul>
            </div>

            <div class="mb-5">
              <h2 class="h4 text-white fw-semibold mb-3" style="font-family: var(--font-family-heading);">
                2. Controlling & Clearing Browser Storage
              </h2>
              <p class="text-neutral-300 mb-3" style="color: #94A3B8;">
                You retain complete control over your browser's cookies and local storage. You can inspect, modify, or erase stored data at any time:
              </p>
              <ul class="text-neutral-300 ps-4 mb-3" style="color: #CBD5E1; line-height: 1.8;">
                <li class="mb-2"><strong class="text-white">Google Chrome:</strong> Settings → Privacy and Security → Delete Browsing Data → Cookies and other site data.</li>
                <li class="mb-2"><strong class="text-white">Mozilla Firefox:</strong> Settings → Privacy & Security → Cookies and Site Data → Clear Data.</li>
                <li class="mb-2"><strong class="text-white">Apple Safari:</strong> Settings / Preferences → Privacy → Manage Website Data → Remove All.</li>
              </ul>
              <p class="text-neutral-300" style="color: #94A3B8;">
                Clearing your browser storage simply resets your dark/light theme preference to your operating system default and will not restrict access to any page or service on our website.
              </p>
            </div>

            <div class="p-4 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08);">
              <h2 class="h4 text-white fw-semibold mb-3" style="font-family: var(--font-family-heading);">
                3. Questions Regarding Cookies & Storage
              </h2>
              <p class="text-neutral-300 mb-0" style="color: #CBD5E1;">
                For inquiries regarding our lightweight storage policies, reach out to our engineering team at <a href="mailto:contact@vesharo.com" class="text-decoration-none" style="color: var(--vesharo-electric-accent, #00d2ff);">contact@vesharo.com</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Subscribe1 />
</Layout>
