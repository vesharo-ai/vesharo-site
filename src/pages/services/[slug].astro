---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb.astro";
import HeaderSlider from "@/components/heading-slider/HeaderSlider";
import Subscribe1 from "@/components/subscribe/Subscribe1.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getServiceJsonLd, getFaqJsonLd } from "@/lib/jsonLd";
import { siteConfig } from "@/config/site";

export async function getStaticPaths() {
  const allServices = await getCollection("services");
  const allPortfolio = await getCollection("portfolio");
  const sortedServices = [...allServices].sort((a, b) => a.data.order - b.data.order);

  return sortedServices.map((service) => {
    const relatedPortfolio = service.data.relatedCaseStudyId
      ? allPortfolio.find((p) => p.data.id === service.data.relatedCaseStudyId)
      : undefined;

    const relatedServices = sortedServices
      .filter((s) => s.data.id !== service.data.id)
      .slice(0, 3);

    return {
      params: { slug: service.data.id },
      props: {
        service,
        relatedPortfolio,
        relatedServices,
        allServicesList: sortedServices,
      },
    };
  });
}

interface Props {
  service: CollectionEntry<"services">;
  relatedPortfolio?: CollectionEntry<"portfolio">;
  relatedServices: CollectionEntry<"services">[];
  allServicesList: CollectionEntry<"services">[];
}

const { service, relatedPortfolio, relatedServices, allServicesList } = Astro.props;
const data = service.data;

const serviceJsonLd = getServiceJsonLd({
  name: `${data.title} — Vesharo`,
  description: data.fullDescription,
  path: `/services/${data.id}`,
  serviceType: data.title,
});

const faqJsonLd = data.faqs && data.faqs.length > 0 ? getFaqJsonLd(data.faqs) : null;
const schemas = faqJsonLd ? [serviceJsonLd, faqJsonLd] : [serviceJsonLd];
---

<Layout
  title={`${data.title} Services | Vesharo`}
  description={data.fullDescription.slice(0, 155)}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Services", path: "/services" },
    { name: data.title, path: `/services/${data.id}` },
  ]}
  jsonLd={schemas}
>
  <BreadCrumb title={data.title} />
  <HeaderSlider />

  <section class="py-5" style="background-color: #0b0f19;">
    <div class="container py-lg-4">
      <div class="row g-5">
        <!-- Main Content Column -->
        <div class="col-lg-8">
          <div class="p-4 p-md-5 rounded-4 mb-4" style="background-color: #0f1626; border: 1px solid rgba(255, 255, 255, 0.08);">
            <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-4" style="width: 64px; height: 64px; background-color: rgba(0, 102, 255, 0.15); border: 1px solid rgba(0, 102, 255, 0.3);">
              <i class={`${data.icon} text-primary`} style="font-size: 2rem;"></i>
            </div>

            <h1 class="h2 text-white fw-bold mb-3">{data.title}</h1>
            <p class="text-white-50 lead mb-4" style="line-height: 1.7;">
              {data.fullDescription}
            </p>

            <!-- 1. Buyer Problem / The Challenge -->
            {data.problemStatement && (
              <div class="mb-5 p-4 rounded-3" style="background-color: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.2); border-left: 4px solid #ef4444;">
                <div class="d-flex align-items-center gap-2 mb-2">
                  <i class="ph ph-warning-circle text-danger" style="font-size: 1.25rem;"></i>
                  <h2 class="h5 text-white fw-semibold mb-0">The Problem & Industry Bottleneck</h2>
                </div>
                <p class="text-white-50 mb-0 small" style="line-height: 1.7;">
                  {data.problemStatement}
                </p>
              </div>
            )}

            <!-- 2. When to Use / Ideal Fit -->
            {data.useCases && data.useCases.length > 0 && (
              <div class="mb-5">
                <h2 class="h4 text-white fw-semibold mb-3">When to Use & Ideal Fit</h2>
                <p class="text-white-50 mb-3">
                  How modern organizations leverage this capability to eliminate friction, automate workflows, and scale revenue:
                </p>
                <ul class="list-unstyled text-white-50">
                  {data.useCases.map((uc) => (
                    <li class="d-flex align-items-start gap-3 mb-3 p-3 rounded-3" style="background-color: rgba(255, 255, 255, 0.02); border-left: 3px solid #0066FF;">
                      <i class="ph ph-arrow-right text-primary mt-1"></i>
                      <span>{uc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- 3. Tangible Client Deliverables -->
            <div class="mb-5">
              <h2 class="h4 text-white fw-semibold mb-3">Tangible Client Deliverables</h2>
              <p class="text-white-50 mb-3">
                Every client engagement produces clear, production-tested assets with full intellectual property ownership:
              </p>
              <div class="row g-3">
                {data.deliverables.map((d) => (
                  <div class="col-md-6">
                    <div class="p-3 rounded-3 h-100" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06);">
                      <div class="d-flex align-items-start gap-2">
                        <i class="ph ph-check-square-offset text-primary mt-1" style="font-size: 1.25rem;"></i>
                        <div>
                          <strong class="text-white d-block small mb-1">{d}</strong>
                          <span class="text-white-50 small" style="font-size: 0.8rem;">100% intellectual property transferred.</span>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- 4. Technical Approach & Capabilities -->
            <div class="mb-5">
              <h2 class="h4 text-white fw-semibold mb-3">Technical Approach & Capabilities</h2>
              <p class="text-white-50 mb-4">
                Our engineering squads take an end-to-end approach, handling architectural design, prototype validation, hardening, and production cloud operations:
              </p>
              <div class="row g-3 mb-4">
                {data.features.map((feature) => (
                  <div class="col-md-6">
                    <div class="p-3 rounded-3 h-100" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05);">
                      <div class="d-flex align-items-start gap-2">
                        <i class="ph ph-check-circle text-primary mt-1" style="font-size: 1.25rem;"></i>
                        <span class="text-white small fw-medium">{feature}</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              {data.techStack && data.techStack.length > 0 && (
                <div class="p-3 rounded-3" style="background-color: rgba(0, 102, 255, 0.05); border: 1px solid rgba(0, 102, 255, 0.2);">
                  <span class="text-white-50 small text-uppercase tracking-wider fw-bold d-block mb-2">Core Production Stack:</span>
                  <div class="d-flex flex-wrap gap-2">
                    {data.techStack.map((tech) => (
                      <span class="badge px-3 py-1 rounded-pill text-white" style="background-color: rgba(255, 255, 255, 0.08); font-weight: 500;">
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <!-- 5. 4-Stage Delivery Process -->
            {data.process && data.process.length > 0 && (
              <div class="mb-5">
                <h2 class="h4 text-white fw-semibold mb-3">Our 4-Stage Engineering Process</h2>
                <p class="text-white-50 mb-4">
                  We operate in focused 2-week agile sprints with transparent milestone reviews and working preview environments:
                </p>
                <div class="row g-3">
                  {data.process.map((step, idx) => (
                    <div class="col-12">
                      <div class="p-3 p-md-4 rounded-3 d-flex gap-3 align-items-start" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05);">
                        <span class="badge rounded-circle p-2 d-inline-flex align-items-center justify-content-center text-primary" style="width: 36px; height: 36px; background-color: rgba(0, 102, 255, 0.2); font-weight: bold;">
                          0{idx + 1}
                        </span>
                        <div>
                          <h3 class="h6 text-white fw-semibold mb-1">{step.step}</h3>
                          <p class="text-white-50 small mb-0">{step.desc}</p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- 6. Related Product Proof -->
            {relatedPortfolio && (
              <div class="mb-5 p-4 p-md-5 rounded-4" style="background-color: #070B14; border: 1px solid rgba(0, 102, 255, 0.35);">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                  <span class="badge px-3 py-2 rounded-pill text-primary" style="background-color: rgba(0, 102, 255, 0.15); font-size: 0.8rem;">
                    Proven In Production
                  </span>
                  {relatedPortfolio.data.status && (
                    <span class="badge px-2 py-1 rounded text-white" style="background-color: rgba(39, 201, 63, 0.2); color: #27C93F; font-size: 0.75rem;">
                      {relatedPortfolio.data.status}
                    </span>
                  )}
                </div>
                <h3 class="h4 text-white fw-bold mb-2">Real Implementation: {relatedPortfolio.data.title}</h3>
                <p class="text-primary small fw-semibold mb-3">{relatedPortfolio.data.tagline}</p>
                <p class="text-white-50 small mb-4" style="line-height: 1.7;">
                  {relatedPortfolio.data.description}
                </p>
                <div class="mb-4">
                  <ul class="list-unstyled text-white-50 small mb-0">
                    {relatedPortfolio.data.metrics.slice(0, 2).map((m) => (
                      <li class="d-flex align-items-start mb-2">
                        <i class="ph ph-check-circle text-primary me-2 mt-1"></i>
                        <span>{m}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <a
                  href={`/portfolio/${relatedPortfolio.data.id}`}
                  class="btn btn-outline-primary px-4 py-2 rounded-pill small fw-semibold d-inline-flex align-items-center gap-2"
                >
                  <span>Explore Case Study</span>
                  <i class="ph ph-arrow-right"></i>
                </a>
              </div>
            )}

            <!-- 7. Frequently Asked Questions -->
            {data.faqs && data.faqs.length > 0 && (
              <div class="mb-5">
                <h2 class="h4 text-white fw-semibold mb-3">Frequently Asked Questions</h2>
                <div class="d-flex flex-column gap-3">
                  {data.faqs.map((f) => (
                    <details class="p-3 rounded-3" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); cursor: pointer;">
                      <summary class="text-white fw-medium mb-2">{f.question}</summary>
                      <p class="text-white-50 small mb-0 pt-2 border-top border-secondary border-opacity-25" style="line-height: 1.7;">
                        {f.answer}
                      </p>
                    </details>
                  ))}
                </div>
              </div>
            )}

            <!-- 8. Clear CTA Section -->
            <div class="p-4 p-md-5 rounded-4 text-center" style="background: linear-gradient(135deg, rgba(0, 102, 255, 0.15) 0%, rgba(0, 210, 255, 0.05) 100%); border: 1px solid rgba(0, 102, 255, 0.35);">
              <h2 class="h3 text-white fw-bold mb-3">Ready to Scope Your {data.title} Architecture?</h2>
              <p class="text-white-50 small mx-auto mb-4" style="max-width: 580px; line-height: 1.7;">
                Schedule a complimentary 15-minute scoping call with our technical leadership. We'll assess technical feasibility, deliver an initial architectural estimate, and map out sprint deliverables.
              </p>
              <div class="d-flex flex-wrap align-items-center justify-content-center gap-3">
                <a href={siteConfig.contact.bookingUrl} class="btn btn-primary px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2">
                  <span>Book a 15-Minute Call</span>
                  <i class="ph ph-arrow-right"></i>
                </a>
                <a href={`mailto:${siteConfig.contact.email}`} class="btn btn-outline-secondary px-4 py-2 rounded-pill text-white fw-semibold">
                  <span>Email Technical Team</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Bottom Related Services Navigation -->
          {relatedServices && relatedServices.length > 0 && (
            <div class="p-4 rounded-4" style="background-color: #0f1626; border: 1px solid rgba(255, 255, 255, 0.08);">
              <h3 class="h5 text-white fw-bold mb-3">Related Capabilities</h3>
              <div class="row g-3">
                {relatedServices.map((rs) => (
                  <div class="col-md-4">
                    <a
                      href={`/services/${rs.data.id}`}
                      class="p-3 rounded-3 d-block text-decoration-none h-100 transition-all"
                      style="background-color: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05);"
                    >
                      <div class="d-flex align-items-center gap-2 mb-2">
                        <i class={`${rs.data.icon} text-primary`} style="font-size: 1.25rem;"></i>
                        <span class="text-white small fw-bold">{rs.data.title}</span>
                      </div>
                      <p class="text-white-50 small mb-0" style="font-size: 0.8rem; line-height: 1.5;">
                        {rs.data.shortDescription}
                      </p>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar Column -->
        <div class="col-lg-4">
          <div class="position-sticky" style="top: 100px;">
            <!-- Consultation Card -->
            <div class="p-4 rounded-4 mb-4" style="background-color: #0f1626; border: 1px solid rgba(0, 102, 255, 0.3);">
              <h2 class="h5 text-white fw-bold mb-2">Build With Vesharo</h2>
              <p class="text-white-50 small mb-4">
                Schedule a 15-minute call with our engineering leads to scope your app or system.
              </p>
              <a href={siteConfig.contact.bookingUrl} class="btn btn-primary w-100 py-2 rounded-pill fw-semibold mb-3">
                Book a 15-Minute Call
              </a>
              <div class="text-center">
                <span class="text-white-50 small">Direct email: </span>
                <a href={`mailto:${siteConfig.contact.email}`} class="text-primary text-decoration-none small">{siteConfig.contact.email}</a>
              </div>
            </div>

            <!-- Tech Stack Pill Box -->
            {data.techStack && data.techStack.length > 0 && (
              <div class="p-4 rounded-4 mb-4" style="background-color: #0f1626; border: 1px solid rgba(255, 255, 255, 0.08);">
                <h2 class="h6 text-white text-uppercase tracking-wider small fw-bold mb-3">Production Tech Stack</h2>
                <div class="d-flex flex-wrap gap-2">
                  {data.techStack.map((tech) => (
                    <span class="badge px-3 py-2 rounded-pill text-white" style="background-color: rgba(255, 255, 255, 0.08); font-weight: normal;">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <!-- All Capabilities Link List -->
            <div class="p-4 rounded-4" style="background-color: #0f1626; border: 1px solid rgba(255, 255, 255, 0.08);">
              <h2 class="h6 text-white text-uppercase tracking-wider small fw-bold mb-3">All Capabilities</h2>
              <div class="d-flex flex-column gap-2">
                {allServicesList.map((svc) => (
                  <a
                    href={`/services/${svc.data.id}`}
                    class={`text-decoration-none small py-1 d-flex align-items-center justify-content-between ${
                      svc.data.id === data.id ? "text-primary fw-bold" : "text-white-50 hover-text-primary"
                    }`}
                  >
                    <span>{svc.data.title}</span>
                    {svc.data.id === data.id && <i class="ph ph-arrow-right small"></i>}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Subscribe1 spacingClass="tz-mt-lg-80" />
</Layout>
