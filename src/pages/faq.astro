---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb.astro";
import HeaderSlider from "@/components/heading-slider/HeaderSlider";
import Subscribe1 from "@/components/subscribe/Subscribe1.astro";
import { getCollection } from "astro:content";
import { getFaqJsonLd } from "@/lib/jsonLd";

const allFaqs = await getCollection("faq");
const sortedFaqs = allFaqs.sort((a, b) => a.data.order - b.data.order);

const categories = [
  { id: "general", name: "General", icon: "ph-info" },
  { id: "ai-automation", name: "AI Automation", icon: "ph-cpu" },
  { id: "development", name: "Development", icon: "ph-code" },
  { id: "process-timeline", name: "Process & Timeline", icon: "ph-git-branch" },
  { id: "pricing-payments", name: "Pricing & Payments", icon: "ph-currency-circle-dollar" },
  { id: "support-ownership", name: "Support & Ownership", icon: "ph-shield-check" },
];

const categoryMap: Record<string, string> = {
  "General": "general",
  "AI Automation": "ai-automation",
  "Development": "development",
  "Process & Timeline": "process-timeline",
  "Pricing & Payments": "pricing-payments",
  "Support & Ownership": "support-ownership",
};

const groupedFaqs = categories.map((cat) => ({
  ...cat,
  items: sortedFaqs.filter((f) => categoryMap[f.data.category] === cat.id),
}));

const faqSchema = getFaqJsonLd(
  sortedFaqs.map(({ data }) => ({
    question: data.question,
    answer: data.answer,
  }))
);
---

<Layout
  title="Frequently Asked Questions | Engineering, AI & Pricing | Vesharo"
  description="Clear answers on 100% IP ownership, AI security guardrails, transparent engagement models, and 2-week agile sprint delivery."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "FAQ", path: "/faq" },
  ]}
  jsonLd={faqSchema}
>
  <BreadCrumb title="Frequently Asked Questions" />
  <HeaderSlider />

  <section class="tz-faq-page py-5" style="background-color: var(--vesharo-navy-base, #070B14); color: #fff;">
    <div class="container py-4">
      <!-- Section Header -->
      <div class="row justify-content-center text-center mb-5">
        <div class="col-lg-8">
          <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(0, 210, 255, 0.1); border: 1px solid rgba(0, 210, 255, 0.25);">
            <i class="ph ph-question text-cyan" style="color: var(--vesharo-electric-accent, #00d2ff);"></i>
            <span class="tz-text-xs text-uppercase fw-semibold tracking-wider text-cyan" style="color: var(--vesharo-electric-accent, #00d2ff); letter-spacing: 0.08em;">
              Engineering & Business FAQ
            </span>
          </div>
          <h1 class="tz-display-2 fw-bold mb-3" style="font-family: var(--font-family-heading);">
            Direct Answers to Real Technical Questions
          </h1>
          <p class="tz-text-l text-neutral-400 mx-auto" style="max-width: 680px; color: #94A3B8;">
            Everything you need to know about code ownership, security perimeters, delivery timelines, and how we collaborate with your team.
          </p>

          <!-- Category Quick-Jump Navigation -->
          <nav aria-label="FAQ Categories" class="d-flex flex-wrap justify-content-center gap-2 mt-4 pt-2">
            {categories.map((cat) => (
              <a
                href={`#${cat.id}`}
                class="category-nav-pill d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill text-decoration-none fw-medium tz-text-s"
                style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #E2E8F0; transition: all 0.2s ease;"
              >
                <i class={`ph ${cat.icon}`} style="color: var(--vesharo-electric-accent, #00d2ff);"></i>
                <span>{cat.name}</span>
              </a>
            ))}
          </nav>
        </div>
      </div>

      <!-- FAQ Groups -->
      <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
          {groupedFaqs.map((group) => (
            <div id={group.id} class="faq-group mb-5 pt-3">
              <div class="d-flex align-items-center gap-3 pb-3 mb-4 border-bottom" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                <div class="d-inline-flex align-items-center justify-content-center rounded-3" style="width: 44px; height: 44px; background: rgba(0, 102, 255, 0.15); border: 1px solid rgba(0, 102, 255, 0.3);">
                  <i class={`ph ${group.icon} fs-4`} style="color: var(--vesharo-electric-accent, #00d2ff);"></i>
                </div>
                <div>
                  <h2 class="h3 fw-bold mb-0 text-white" style="font-family: var(--font-family-heading);">
                    {group.name}
                  </h2>
                  <span class="tz-text-xs text-neutral-400" style="color: #64748B;">
                    {group.items.length} questions answered
                  </span>
                </div>
              </div>

              <div class="faq-accordion-container d-flex flex-column gap-3">
                {group.items.map((item) => (
                  <details
                    id={item.data.id}
                    class="faq-card p-3 p-md-4 rounded-3"
                    style="background: rgba(11, 15, 25, 0.85); border: 1px solid rgba(255, 255, 255, 0.08); transition: border-color 0.2s ease;"
                    open={false}
                  >
                    <summary
                      class="d-flex align-items-center justify-content-between fw-semibold text-white cursor-pointer"
                      style="list-style: none; cursor: pointer; font-size: 1.05rem;"
                    >
                      <span class="d-flex align-items-start gap-2 pe-3">
                        <span class="text-primary fw-bold" style="color: var(--vesharo-electric-accent, #00d2ff);">Q.</span>
                        <span>{item.data.question}</span>
                      </span>
                      <div class="faq-toggle-icon d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 28px; height: 28px; background: rgba(255, 255, 255, 0.05);">
                        <i class="ph ph-plus" style="color: var(--vesharo-electric-accent, #00d2ff); transition: transform 0.2s ease;"></i>
                      </div>
                    </summary>
                    <div class="faq-answer pt-3 mt-3 border-top" style="border-color: rgba(255, 255, 255, 0.06) !important;">
                      <p class="mb-0 tz-text-m" style="color: #CBD5E1; line-height: 1.7;">
                        {item.data.answer}
                      </p>
                      <div class="mt-3 pt-2 d-flex align-items-center justify-content-between">
                        <a
                          href={`#${item.data.id}`}
                          class="permalink-btn d-inline-flex align-items-center gap-1 tz-text-xs text-decoration-none"
                          style="color: #64748B;"
                          title="Copy link to this answer"
                        >
                          <i class="ph ph-link-simple"></i>
                          <span>Direct link</span>
                        </a>
                        <a
                          href="/contact"
                          class="tz-text-xs text-decoration-none fw-medium"
                          style="color: var(--vesharo-electric-accent, #00d2ff);"
                        >
                          Have a specific question? Ask our architects &rarr;
                        </a>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Deep Link & URL Hash Auto-Open Script -->
  <script is:inline>
    function handleHashChange() {
      const hash = window.location.hash ? window.location.hash.substring(1) : "";
      if (!hash) return;
      const targetEl = document.getElementById(hash);
      if (targetEl) {
        if (targetEl.tagName.toLowerCase() === "details") {
          targetEl.setAttribute("open", "");
          targetEl.scrollIntoView({ behavior: "smooth", block: "center" });
        } else if (targetEl.classList.contains("faq-group")) {
          targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }
    }

    window.addEventListener("DOMContentLoaded", handleHashChange);
    window.addEventListener("hashchange", handleHashChange);
  </script>

  <style>
    summary::-webkit-details-marker {
      display: none;
    }
    .category-nav-pill:hover {
      background: rgba(0, 102, 255, 0.15) !important;
      border-color: var(--vesharo-electric-accent, #00d2ff) !important;
      color: #fff !important;
      transform: translateY(-1px);
    }
    .faq-card:hover {
      border-color: rgba(0, 210, 255, 0.25) !important;
    }
    details[open] {
      border-color: rgba(0, 210, 255, 0.35) !important;
      background: rgba(14, 20, 34, 0.95) !important;
    }
    details[open] summary .faq-toggle-icon i {
      transform: rotate(45deg);
    }
    .permalink-btn:hover {
      color: var(--vesharo-electric-accent, #00d2ff) !important;
    }
  </style>

  <Subscribe1 />
</Layout>
