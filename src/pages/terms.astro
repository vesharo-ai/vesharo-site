---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb";
import { brand } from "@/config/brand";
---

<Layout
  title={`Terms of Service | ${brand.name}`}
  description={`Terms of Service governing the use of ${brand.legalName}'s website and engineering consultation engagements.`}
>
  <BreadCrumb client:load title="Terms of Service" />

  <section class="tz-pt-60 tz-pb-60 tz-pt-lg-120 tz-pb-lg-120 tz-bg-neutral3">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-10">
          <div class="p-4 p-lg-5 rounded-3 tz-bg-neutral2 border border-secondary text-white">
            <h2 class="tz-display-4 mb-4 text-uppercase tz-text-neutral5">Terms of Service</h2>
            <p class="tz-text-neutral6 tz-text-m mb-4">
              <strong>Effective Date:</strong> October 2026
            </p>

            <h3 class="tz-text-neutral5 mt-4 mb-3">1. Agreement to Terms</h3>
            <p class="tz-text-neutral6 tz-text-l fw-light">
              By accessing or using the website of {brand.legalName} ("Vesharo", "{brand.seo.siteUrl}"), you agree to be bound by these Terms of Service. If you do not agree with any part of these terms, please do not use our website.
            </p>

            <h3 class="tz-text-neutral5 mt-4 mb-3">2. Engineering &amp; Consulting Engagements</h3>
            <p class="tz-text-neutral6 tz-text-l fw-light">
              Website content, service summaries, and pricing indicators do not constitute a binding contract. Formal software engineering engagements, pods, and deliverables are governed exclusively by executed Master Services Agreements (MSAs) and Statements of Work (SOWs) specifying scope, milestones, timelines, and payment terms.
            </p>

            <h3 class="tz-text-neutral5 mt-4 mb-3">3. Intellectual Property Rights</h3>
            <p class="tz-text-neutral6 tz-text-l fw-light">
              All website text, branding, graphics, logos, and custom code components are the intellectual property of {brand.legalName}. Client deliverables, source code, and assets created under signed client contracts transfer 100% intellectual property ownership to the client upon final payment, as detailed in our standard client agreement.
            </p>

            <h3 class="tz-text-neutral5 mt-4 mb-3">4. Limitation of Liability</h3>
            <p class="tz-text-neutral6 tz-text-l fw-light">
              Information on this website is provided "as is" without warranty of any kind. Vesharo shall not be liable for any direct, indirect, incidental, or consequential damages resulting from the use or inability to use this website.
            </p>

            <h3 class="tz-text-neutral5 mt-4 mb-3">5. Inquiries &amp; Legal Notices</h3>
            <p class="tz-text-neutral6 tz-text-l fw-light">
              For any legal questions or contractual notices, please reach out directly to:
              <br />
              <a href={`mailto:${brand.contact.email}`} class="tz-text-primary fw-medium">{brand.contact.email}</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
