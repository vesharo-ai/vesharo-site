---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb.astro";
import HeaderSlider from "@/components/heading-slider/HeaderSlider";
import Subscribe1 from "@/components/subscribe/Subscribe1.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("portfolio");

// Category filtering via query params (compatible with static and server rendering)
const currentCategory = Astro.url.searchParams.get("category") || "all";

const categories = ["all", ...new Set(allProjects.map((p) => p.data.category))];

const filteredProjects = currentCategory === "all"
  ? allProjects
  : allProjects.filter((p) => p.data.category === currentCategory);

const portfolioJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Vesharo Verified Portfolio & Case Studies",
  description: "Real production case studies built by Vesharo: LockApp, NavratriOS, Wirebench, and MedMarketMD.",
  hasPart: filteredProjects.map((p) => ({
    "@type": "CreativeWork",
    name: p.data.title,
    headline: p.data.tagline,
    description: p.data.description,
    url: `https://vesharo.com/portfolio/${p.data.id}`,
    creator: {
      "@type": "Organization",
      name: "Vesharo",
    },
  })),
};
---

<Layout
  title="Real Portfolio & Case Studies | Vesharo"
  description="Explore production platforms built by Vesharo: LockApp (B2B MDM SaaS), NavratriOS (Gate Ticketing), Wirebench (API Governance), and MedMarketMD."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Portfolio", path: "/portfolio" },
  ]}
  jsonLd={portfolioJsonLd}
>
  <BreadCrumb title="Case Studies" />
  <HeaderSlider />

  <!-- Portfolio Hub Grid -->
  <section class="py-5" style="background-color: #0b0f19;">
    <div class="container py-lg-4">
      <div class="text-center mb-5">
        <span class="badge px-3 py-2 rounded-pill text-primary mb-3" style="background-color: rgba(0, 102, 255, 0.12); font-size: 0.875rem;">
          Verified Production Work
        </span>
        <h1 class="h1 text-white fw-bold mb-3">Real Products Engineered for Production Scale</h1>
        <p class="text-white-50 lead mx-auto mb-4" style="max-width: 720px;">
          We adhere to strict content integrity: no invented client logos or fictitious case studies. Here is the verified software we have built and deployed.
        </p>

        <!-- Category Filter Links (Works Without JavaScript) -->
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
          {categories.map((cat) => {
            const isActive = currentCategory === cat;
            const href = cat === "all" ? "/portfolio" : `/portfolio?category=${encodeURIComponent(cat)}`;
            return (
              <a
                href={href}
                class={`btn rounded-pill px-3 py-1 small fw-semibold transition-all ${
                  isActive
                    ? "btn-primary"
                    : "btn-outline-secondary text-white-50 border-secondary border-opacity-25"
                }`}
                style="font-size: 0.85rem;"
              >
                {cat === "all" ? "All Products" : cat}
              </a>
            );
          })}
        </div>
      </div>

      <div class="row g-4">
        {filteredProjects.map(({ data }) => (
          <div class="col-lg-6">
            <div
              class="p-4 p-md-5 rounded-4 h-100 d-flex flex-column justify-content-between"
              style="background-color: #0f1626; border: 1px solid rgba(255, 255, 255, 0.08);"
            >
              <div>
                <!-- Mockup Preview Graphic -->
                <div class="mb-4 rounded-3 overflow-hidden p-2 text-center" style="background-color: #070B14; border: 1px solid rgba(255, 255, 255, 0.05);">
                  <img
                    src={data.image}
                    alt={`${data.title} product screen mockup`}
                    class="img-fluid rounded"
                    width="600"
                    height="340"
                    style="max-height: 240px; width: auto; object-fit: contain;"
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                  <span class="badge px-3 py-2 rounded-pill text-primary" style="background-color: rgba(0, 102, 255, 0.12); font-size: 0.8rem;">
                    {data.category}
                  </span>
                  <div class="d-flex align-items-center gap-2">
                    {data.status && (
                      <span
                        class="badge px-2 py-1 rounded"
                        style={
                          data.status.toLowerCase().includes("beta") || data.status.toLowerCase().includes("development")
                            ? "background-color: rgba(245, 166, 35, 0.2); color: #F5A623; font-size: 0.75rem;"
                            : "background-color: rgba(39, 201, 63, 0.2); color: #27C93F; font-size: 0.75rem;"
                        }
                      >
                        {data.status}
                      </span>
                    )}
                    <span class="text-white-50 small">{data.year}</span>
                  </div>
                </div>

                <h2 class="h3 text-white fw-bold mb-2">{data.title}</h2>
                <p class="text-primary small fw-semibold mb-3">{data.tagline}</p>
                <p class="text-white-50 small mb-4" style="line-height: 1.7;">
                  {data.description}
                </p>

                {data.role && (
                  <div class="mb-3 small">
                    <span class="text-white-50">Our Engineering Role: </span>
                    <strong class="text-white">{data.role}</strong>
                  </div>
                )}

                <h3 class="h6 text-white text-uppercase tracking-wider small fw-bold mb-2">Key Outcomes</h3>
                <ul class="list-unstyled text-white-50 small mb-4">
                  {data.metrics.map((m) => (
                    <li class="d-flex align-items-start mb-2">
                      <i class="ph-check-circle text-primary me-2 mt-1"></i>
                      <span>{m}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <div class="d-flex flex-wrap gap-1 mb-4">
                  {data.stack.map((s) => (
                    <span class="badge px-2 py-1 rounded text-white-50" style="background-color: rgba(255, 255, 255, 0.05); font-size: 0.75rem;">
                      {s}
                    </span>
                  ))}
                </div>

                <a
                  href={`/portfolio/${data.id}`}
                  class="btn btn-outline-primary w-100 py-2 rounded-pill d-inline-flex align-items-center justify-content-center gap-2"
                >
                  <span>Read Full Case Study</span>
                  <i class="ph-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Subscribe1 spacingClass="tz-mt-lg-80" />
</Layout>
