---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb.astro";
import HeaderSlider from "@/components/heading-slider/HeaderSlider";
import Subscribe1 from "@/components/subscribe/Subscribe1.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const allProjects = await getCollection("portfolio");
  return allProjects.map((project) => ({
    params: { slug: project.data.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"portfolio">;
}

const { project } = Astro.props;
const data = project.data;
---

<Layout
  title={`${data.title} Case Study | Vesharo`}
  description={data.description.slice(0, 155)}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Portfolio", path: "/portfolio" },
    { name: data.title, path: `/portfolio/${data.id}` },
  ]}
>
  <BreadCrumb title={data.title} />
  <HeaderSlider />

  <section class="py-5" style="background-color: #0b0f19;">
    <div class="container py-lg-4">
      <div class="row g-5">
        <!-- Main Case Study Content -->
        <div class="col-lg-8">
          <div class="p-4 p-md-5 rounded-4 mb-4" style="background-color: #0f1626; border: 1px solid rgba(255, 255, 255, 0.08);">
            <div class="d-flex align-items-center gap-3 mb-3">
              <span class="badge px-3 py-2 rounded-pill text-primary" style="background-color: rgba(0, 102, 255, 0.12); font-size: 0.85rem;">
                {data.category}
              </span>
              <span class="text-white-50 small">Production Year: {data.year}</span>
            </div>

            <h1 class="h2 text-white fw-bold mb-2">{data.title}</h1>
            <p class="text-primary lead fw-semibold mb-4">{data.tagline}</p>
            <p class="text-white-50 lead mb-5" style="line-height: 1.7;">
              {data.description}
            </p>

            <!-- The Challenge -->
            {data.challenge && (
              <div class="mb-5">
                <h2 class="h4 text-white fw-semibold mb-3">The Architectural Challenge</h2>
                <div class="p-4 rounded-3" style="background-color: rgba(255, 255, 255, 0.02); border-left: 4px solid #00D2FF;">
                  <p class="text-white-50 mb-0" style="line-height: 1.7;">
                    {data.challenge}
                  </p>
                </div>
              </div>
            )}

            <!-- The Engineering Solution -->
            {data.solution && (
              <div class="mb-5">
                <h2 class="h4 text-white fw-semibold mb-3">The Engineering Solution</h2>
                <p class="text-white-50 mb-4" style="line-height: 1.7;">
                  {data.solution}
                </p>
              </div>
            )}

            <!-- Architecture Components -->
            {data.architecture && data.architecture.length > 0 && (
              <div class="mb-5">
                <h2 class="h4 text-white fw-semibold mb-3">System Architecture & Highlights</h2>
                <div class="row g-3">
                  {data.architecture.map((item) => (
                    <div class="col-12">
                      <div class="p-3 rounded-3 d-flex align-items-start gap-3" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05);">
                        <i class="ph-cpu text-primary mt-1" style="font-size: 1.25rem;"></i>
                        <span class="text-white small fw-medium">{item}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Verified Results -->
            <div class="mb-5">
              <h2 class="h4 text-white fw-semibold mb-3">Verified Results & Operational Impact</h2>
              <ul class="text-white-50 ps-4 mb-0">
                {data.metrics.map((m) => (
                  <li class="mb-2"><strong class="text-white">{m}</strong> — verified in production deployment.</li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Sidebar Specifications -->
        <div class="col-lg-4">
          <div class="position-sticky" style="top: 100px;">
            <div class="p-4 rounded-4 mb-4" style="background-color: #0f1626; border: 1px solid rgba(255, 255, 255, 0.08);">
              <h2 class="h5 text-white fw-bold mb-4">Project Overview</h2>

              <div class="mb-3">
                <span class="text-white-50 small d-block mb-1">Target Client Domain</span>
                <span class="text-white fw-medium">{data.client}</span>
              </div>

              <div class="mb-3">
                <span class="text-white-50 small d-block mb-1">Deployment Year</span>
                <span class="text-white fw-medium">{data.year}</span>
              </div>

              <div class="mb-4">
                <span class="text-white-50 small d-block mb-1">Core Tech Stack</span>
                <div class="d-flex flex-wrap gap-2 mt-2">
                  {data.stack.map((s) => (
                    <span class="badge px-3 py-2 rounded-pill text-white" style="background-color: rgba(255, 255, 255, 0.08);">
                      {s}
                    </span>
                  ))}
                </div>
              </div>

              <a href="/contact" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold">
                Discuss a Similar Project
              </a>
            </div>

            <!-- All Real Portfolio Links -->
            <div class="p-4 rounded-4" style="background-color: #0f1626; border: 1px solid rgba(255, 255, 255, 0.08);">
              <h2 class="h6 text-white text-uppercase tracking-wider small fw-bold mb-3">Other Real Case Studies</h2>
              <div class="d-flex flex-column gap-2">
                <a href="/portfolio/lockapp" class="text-white-50 text-decoration-none small hover-text-primary py-1">LockApp (Enterprise MDM SaaS)</a>
                <a href="/portfolio/navratrios" class="text-white-50 text-decoration-none small hover-text-primary py-1">NavratriOS (Gate QR Ticketing)</a>
                <a href="/portfolio/wirebench" class="text-white-50 text-decoration-none small hover-text-primary py-1">Wirebench (API Contract Tool)</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Subscribe1 spacingClass="tz-mt-lg-80" />
</Layout>
