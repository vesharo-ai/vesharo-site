---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb.astro";
import HeaderSlider from "@/components/heading-slider/HeaderSlider";
---

<Layout
  title="Project Inquiry Received | Vesharo"
  description="Thank you for reaching out to Vesharo. A senior solutions architect has received your brief and will respond within 24 hours."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Thank You", path: "/thank-you" },
  ]}
  noindex={true}
>
  <BreadCrumb title="Inquiry Received" />
  <HeaderSlider />

  <section class="py-5" style="background-color: var(--vesharo-navy-base, #070B14); color: #fff;">
    <div class="container py-lg-5">
      <div class="row justify-content-center text-center">
        <div class="col-lg-8 col-xl-7">
          <div class="p-4 p-md-5 rounded-4" style="background-color: rgba(11, 15, 25, 0.9); border: 1px solid rgba(255, 255, 255, 0.08);">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4" style="width: 80px; height: 80px; background-color: rgba(0, 102, 255, 0.15); border: 2px solid #0066FF;">
              <i class="ph ph-check-circle text-primary" style="font-size: 2.5rem; color: var(--vesharo-electric-accent, #00d2ff) !important;"></i>
            </div>

            <h1 class="h2 text-white fw-bold mb-3" style="font-family: var(--font-family-heading);">
              Project Brief Received
            </h1>
            <p class="text-neutral-300 lead mb-4" style="color: #CBD5E1; line-height: 1.6;">
              Thank you for reaching out to Vesharo. Your technical inquiry has been routed directly to our engineering desk in Ahmedabad.
            </p>

            <div class="p-4 rounded-3 text-start mb-4" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06);">
              <h2 class="h6 text-white fw-semibold mb-3 d-flex align-items-center gap-2" style="font-family: var(--font-family-heading);">
                <i class="ph ph-list-checks" style="color: var(--vesharo-electric-accent, #00d2ff);"></i>
                What happens next?
              </h2>
              <ol class="text-neutral-300 ps-3 mb-0 small" style="line-height: 2; color: #94A3B8;">
                <li>A principal solutions architect reviews your technical requirements and scope.</li>
                <li>We evaluate architectural feasibility, timeline estimates, and resource squad allocation.</li>
                <li>We respond within <strong>24 business hours</strong> with initial recommendations or a calendar invite for a technical discovery call.</li>
              </ol>
            </div>

            <!-- Instant Booking Option -->
            <div class="p-3 rounded-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2 text-start" style="background: rgba(0, 102, 255, 0.06); border: 1px solid rgba(0, 102, 255, 0.2);">
              <div>
                <p class="text-white fw-semibold mb-0 tz-text-s">Need to talk sooner?</p>
                <p class="text-neutral-400 mb-0 tz-text-xs" style="color: #94A3B8;">Pick a 15-minute call directly on our calendar.</p>
              </div>
              <a href="https://cal.com/vesharo/15min" class="btn btn-sm btn-primary fw-semibold tz-text-xs" style="background: #0066FF; border-color: #0066FF;">
                Book a 15-Minute Call
              </a>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-3">
              <a href="/" class="btn btn-outline-light px-4 py-2 rounded-pill fw-semibold tz-text-s">
                Back to Home
              </a>
              <a href="/portfolio" class="btn btn-outline-info px-4 py-2 rounded-pill fw-semibold tz-text-s" style="color: var(--vesharo-electric-accent, #00d2ff); border-color: var(--vesharo-electric-accent, #00d2ff);">
                Explore Case Studies
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
