---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb.astro";
import HeaderSlider from "@/components/heading-slider/HeaderSlider";
---

<Layout
  title="Inquiry Received | Vesharo"
  description="Thank you for contacting Vesharo. Our senior technical architects have received your inquiry and will respond within 24 hours."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Thank You", path: "/thank-you" },
  ]}
  noindex={true}
>
  <BreadCrumb title="Thank You" />
  <HeaderSlider />

  <section class="py-5" style="background-color: #0b0f19;">
    <div class="container py-lg-5">
      <div class="row justify-content-center text-center">
        <div class="col-lg-8 col-xl-7">
          <div class="p-4 p-md-5 rounded-4" style="background-color: #0f1626; border: 1px solid rgba(255, 255, 255, 0.08);">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4" style="width: 80px; height: 80px; background-color: rgba(0, 102, 255, 0.15); border: 2px solid #0066FF;">
              <i class="ph-check text-primary" style="font-size: 2.5rem;"></i>
            </div>

            <h1 class="h2 text-white fw-bold mb-3">Project Brief Received</h1>
            <p class="text-white-50 lead mb-4">
              Thank you for reaching out to Vesharo. Your project inquiry has been routed directly to our senior engineering desk.
            </p>

            <div class="p-3 rounded-3 text-start mb-4" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.05);">
              <h2 class="h6 text-white fw-semibold mb-2">What happens next?</h2>
              <ol class="text-white-50 ps-3 mb-0 small" style="line-height: 1.8;">
                <li>A principal solutions architect reviews your technical requirements and scope.</li>
                <li>We evaluate architectural feasibility, timeline estimates, and resource squad allocation.</li>
                <li>We respond within <strong>24 business hours</strong> with initial recommendations or a calendar invite for a technical discovery call.</li>
              </ol>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-3">
              <a href="/" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                Back to Home
              </a>
              <a href="/portfolio-details" class="btn btn-outline-light px-4 py-2 rounded-pill fw-semibold">
                View Real Case Studies
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
