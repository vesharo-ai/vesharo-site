---
import Layout from "@/layouts/Layout.astro";
import BreadCrumb from "@/components/breadcrumb/BreadCrumb";
import About1 from "@/components/about/About1";
import About2 from "@/components/about/About2";
import ComparisonMatrix from "@/components/trust/ComparisonMatrix";
import WorkFlow1 from "@/components/wordflows/WorkFlow1";
import Commitments1 from "@/components/trust/Commitments1";
import StatsStrip from "@/components/about/StatsStrip";
import FounderCard from "@/components/about/FounderCard";
import TeamSection from "@/components/about/TeamSection";
import IndustriesSection from "@/components/about/IndustriesSection";
import CtaBand from "@/components/cta/CtaBand";
---

<Layout
  title="About Vesharo | IT Consulting & Custom Software Engineering Company — Ahmedabad, India"
  description="Vesharo is a senior-led software engineering and IT consulting company based in Ahmedabad, India. We build custom web apps, mobile apps, cloud platforms and enterprise software for global businesses. 100% IP ownership guaranteed."
  pageType="AboutPage"
>
  <BreadCrumb client:load title="About Vesharo" />

  <About1 client:visible />
  <StatsStrip />
  <FounderCard client:visible />
  <About2 client:visible />
  <IndustriesSection />
  <TeamSection />

  <ComparisonMatrix client:visible bgClass="tz-bg-neutral1" />

  <WorkFlow1 client:visible />

  <Commitments1 bgClass="tz-bg-neutral2" />

  <CtaBand
    client:visible
    kicker="Next step"
    heading="Talk to a senior Vesharo engineer"
    body="We answer scoping questions before anyone signs anything. If you would rather start with a technical question than a sales call, send that instead — you will get a direct reply from a senior engineer, not a BDR reading from a script."
    label="Talk to Vesharo"
    secondaryLabel="Read the engineering blog"
    secondaryHref="/blog"
  />
</Layout>