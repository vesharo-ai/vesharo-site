---
import Navbar from "@/components/navbar/Navbar";
import Footer from "@/components/footer/Footer.astro";
import ScrollTop from "@/components/scroll-top/ScrollTop";
import SEO from "@/components/seo/SEO.astro";
import type { BreadcrumbItem, ArticleSchemaData } from "@/lib/jsonLd";

import "@/styles/phosphoricons.css";
import "@/styles/animate.css";
import "bootstrap/dist/css/bootstrap.min.css";
import "@/styles/fonts.css";
import "@/styles/tokens.css";
import "@/styles/brand.css";
import "@/styles/globals.css";
import "swiper/css";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  article?: ArticleSchemaData;
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const seoProps = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Primary Metadata & Structured Data via SEO Component -->
    <SEO {...seoProps} />

    <!-- Preload Critical Self-Hosted Variable Fonts -->
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Theme Initialization Script (Prevents flash of unstyled theme) -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('vesharo-theme');
        if (storedTheme) {
          document.documentElement.setAttribute('data-theme', storedTheme);
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="tz-bg-neutral3">
    <a href="#main-content" class="skip-to-content visually-hidden-focusable">
      Skip to main content
    </a>
    <Navbar client:load />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ScrollTop client:idle />
  </body>
</html>
