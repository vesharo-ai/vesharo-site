---
import Navbar from "@/components/navbar/Navbar";
import Footer from "@/components/footer/Footer.astro";
import ScrollTop from "@/components/scroll-top/ScrollTop";
import SEO from "@/components/seo/SEO.astro";
import Analytics from "@/components/common/Analytics.astro";
import type { BreadcrumbItem, ArticleSchemaData } from "@/lib/jsonLd";

import "@/styles/phosphoricons.css";
import "@/styles/animate.css";
import "bootstrap/dist/css/bootstrap.min.css";
import "@/styles/fonts.css";
import "@/styles/tokens.css";
import "@/styles/brand.css";
import "@/styles/globals.css";
import "swiper/css";

import { isReviewMode } from "@/lib/reviewMode";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  article?: ArticleSchemaData;
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const seoProps = Astro.props;
const reviewMode = isReviewMode();
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Primary Metadata & Structured Data via SEO Component (Enforces noindex in reviewMode) -->
    <SEO {...seoProps} noindex={reviewMode ? true : seoProps.noindex} />

    <!-- Privacy-Friendly Analytics Wrapper (VS-24) -->
    <Analytics />

    <!-- Preload Critical Self-Hosted Variable Fonts -->
    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Theme Initialization Script (Prevents flash of unstyled theme; Brand default: dark deep navy) -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('vesharo-theme');
        if (storedTheme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class={`tz-bg-neutral3${reviewMode ? " has-review-banner" : ""}`}>
    {reviewMode && (
      <aside class="tz-review-banner" role="alert" aria-label="Review build banner">
        <div class="container d-flex align-items-center justify-content-center gap-2">
          <span class="badge bg-warning text-dark text-uppercase fw-bold" style="font-size: 10px; letter-spacing: 0.08em; padding: 2px 7px;">Review Build</span>
          <span class="review-banner-text">Review build — demo content active for internal sign-off, not final</span>
        </div>
      </aside>
    )}
    <a href="#main-content" class="skip-to-content visually-hidden-focusable">
      Skip to main content
    </a>
    <Navbar client:load />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ScrollTop client:idle />

    <!-- Lightweight Scroll-Reveal Micro-Interactions (IntersectionObserver) -->
    <script is:inline>
      if (typeof window !== "undefined" && "IntersectionObserver" in window) {
        function initScrollReveal() {
          const observer = new IntersectionObserver(
            function(entries) {
              entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-revealed");
                  observer.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -40px 0px" }
          );
          document.querySelectorAll(".reveal-on-scroll").forEach(function(el) {
            observer.observe(el);
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initScrollReveal);
        } else {
          initScrollReveal();
        }
      }
    </script>
  </body>
</html>
