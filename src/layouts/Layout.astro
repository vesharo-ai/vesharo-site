---
import Navbar from "@/components/navbar/Navbar";
import Footer from "@/components/footer/Footer";
import ScrollTop from "@/components/scroll-top/ScrollTop";

import "@/styles/phosphoricons.css";
import "@/styles/animate.css";
import "bootstrap/dist/css/bootstrap.min.css";
import "@/styles/globals.css";
import "swiper/css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DigiFlow | Digital Agency Astro Template",
  description = "Digiflow is a professionally designed template tailored for Digital Agency websites! Whether you’re building a site for any business related to agency, business, digital agency, and portfolio website, modern, clean, and fully customizable templates to help you create an impactful online presence.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&family=Teko:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="tz-bg-neutral3">
    <Navbar client:load />
    <main>
      <slot />
    </main>
    <Footer client:load />
    <ScrollTop client:load />
  </body>
</html>
