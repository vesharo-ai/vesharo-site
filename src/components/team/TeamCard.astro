---
interface Props {
  imageSrc: string;
  name: string;
  title: string;
}

const { imageSrc, name, title } = Astro.props;
---

<div class="col-md-6 col-xl-3">
  <div class="tz-team1-card">
    <div class="tz-team1-card__image">
      <img src={imageSrc} alt={name} />
    </div>
    <div class="tz-team1-card__info">
      <p class="tz-team1-card__name tz-text-xl fw-semibold">{name}</p>
      <p class="tz-team1-card__title tz-text-m fw-light mb-0">
        {title}
      </p>
    </div>
    <div class="tz-team1-card__links">
      <a href="https://github.com/vesharo-ai" target="_blank" rel="noopener noreferrer" class="tz-team1-card__social" aria-label="GitHub">
        <i class="ph ph-github-logo" aria-hidden="true"></i>
      </a>
      <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="tz-team1-card__social" aria-label="LinkedIn">
        <i class="ph ph-linkedin-logo" aria-hidden="true"></i>
      </a>
      <a href="https://x.com" target="_blank" rel="noopener noreferrer" class="tz-team1-card__social" aria-label="X (Twitter)">
        <i class="ph ph-x-logo" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</div>
