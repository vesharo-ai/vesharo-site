---
import SectionSubtitle from "@/components/section-subtitle/SectionSubtitle.astro";
import SectionTitle from "@/components/section-title/SectionTitle.astro";
import TeamCard from "./TeamCard.astro";
import { getCollection } from "astro:content";

interface Props {
  isInnerPage?: boolean;
}

const { isInnerPage = false } = Astro.props;

const allTeam = await getCollection("team");
const teamMembersList = allTeam
  .filter((member) => !member.data.placeholder)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="py-5" style="background-color: #0b0f19;">
  <div class="container py-lg-4">
    <div class="text-center mb-5">
      <SectionSubtitle subtitle="Engineering Leadership" />
      <SectionTitle title="The Minds Behind The Architecture" />
      <p class="text-white-50 lead mx-auto mt-3" style="max-width: 680px;">
        Senior solutions architects and distributed systems engineers leading direct technical execution on every client platform.
      </p>
    </div>

    <div class="row g-4 justify-content-center">
      {teamMembersList.map((member) => (
        <TeamCard
          name={member.data.name}
          role={member.data.role}
          bio={member.data.bio}
          initials={member.data.initials}
          imageSrc={member.data.image}
          socials={member.data.socials}
        />
      ))}
    </div>
  </div>
</section>
