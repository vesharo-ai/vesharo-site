---
const factors = [
  {
    icon: "ph-file-text",
    title: "1. Scope Clarity & Specifications",
    description: "Detailed wireframes and technical user stories allow us to deliver fixed-price certainty. If requirements are still evolving, we recommend an initial 1-week discovery sprint to lock specifications before development.",
  },
  {
    icon: "ph-tree-structure",
    title: "2. Architectural Complexity & Scale",
    description: "A standard web application involves different engineering effort than a high-throughput, low-latency concurrent system (like our NavratriOS gate scanner) or deep Android OS-level Device Owner controllers (like LockApp).",
  },
  {
    icon: "ph-plugs-connected",
    title: "3. Third-Party Integrations & APIs",
    description: "Integration complexity scales with external dependencies: payment gateways, biometric scanners, ERP backends, SMS relays, and LLM tool-calling APIs requiring robust error boundaries and fallback protocols.",
  },
  {
    icon: "ph-shield-check",
    title: "4. Security, Compliance & Data Isolation",
    description: "Projects with stringent compliance requirements (HIPAA, SOC2-readiness, private VPC vector databases, or on-premise model execution) involve specialized security hardening and automated penetration testing.",
  },
  {
    icon: "ph-calendar-check",
    title: "5. Delivery Urgency & Concurrency",
    description: "Standard projects follow a sustainable 2-week agile cadence. If your business faces a critical fundraising deadline or product launch, we can assign parallel dedicated engineering squads to accelerate delivery.",
  },
  {
    icon: "ph-users-three",
    title: "6. Collaboration & Team Ownership",
    description: "Whether you need Vesharo to act as your complete outsourced CTO & engineering team or augment your internal technical staff with specialized AI engineers determines the squad composition.",
  },
];
---

<section class="py-5" style="background-color: var(--vesharo-navy-dark, #0B0F19);">
  <div class="container py-4">
    <div class="row justify-content-center text-center mb-5">
      <div class="col-lg-8">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(0, 102, 255, 0.1); border: 1px solid rgba(0, 102, 255, 0.25);">
          <i class="ph ph-calculator text-primary" style="color: #0066FF;"></i>
          <span class="tz-text-xs text-uppercase fw-semibold tracking-wider" style="color: #60A5FA; letter-spacing: 0.08em;">
            Transparent Methodology
          </span>
        </div>
        <h2 class="tz-display-2 fw-bold text-white mb-3" style="font-family: var(--font-family-heading);">
          How We Estimate Projects
        </h2>
        <p class="tz-text-l text-neutral-400 mx-auto" style="max-width: 680px; color: #94A3B8;">
          Software engineering costs should never be a mystery. We assess six foundational technical parameters to construct accurate, milestone-based estimates.
        </p>
      </div>
    </div>

    <div class="row g-4">
      {factors.map((factor) => (
        <div class="col-md-6 col-lg-4 d-flex">
          <div class="p-4 rounded-3 w-100" style="background: rgba(17, 24, 39, 0.5); border: 1px solid rgba(255, 255, 255, 0.06); transition: border-color 0.2s ease;">
            <div class="d-inline-flex align-items-center justify-content-center rounded-3 p-3 mb-3" style="background: rgba(0, 210, 255, 0.1); border: 1px solid rgba(0, 210, 255, 0.2);">
              <i class={`ph ${factor.icon} fs-4`} style="color: var(--vesharo-electric-accent, #00d2ff);"></i>
            </div>
            <h3 class="h5 fw-bold text-white mb-2" style="font-family: var(--font-family-heading);">
              {factor.title}
            </h3>
            <p class="tz-text-s mb-0" style="color: #94A3B8; line-height: 1.6;">
              {factor.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
