---
const comparisonRows = [
  {
    parameter: "Ideal Project Stage",
    fixedScope: "Defined MVP or discrete feature module",
    squad: "High-growth product scaling & roadmap execution",
    maintenance: "Live production system requiring stability",
    discovery: "Early planning & architectural evaluation",
  },
  {
    parameter: "Team Composition",
    fixedScope: "Assigned project squad for duration of scope",
    squad: "Dedicated senior architect + full-stack engineers",
    maintenance: "On-call reliability engineer + maintenance lead",
    discovery: "Principal Solutions Architect (1-on-1)",
  },
  {
    parameter: "Delivery Cadence",
    fixedScope: "Milestone demonstrations every 2 weeks",
    squad: "Continuous daily deploys & 2-week agile sprints",
    maintenance: "Proactive daily checks + monthly maintenance patch",
    discovery: "Single 30-min consultative deep dive",
  },
  {
    parameter: "Scope Flexibility",
    fixedScope: "Locked statement of work with change orders",
    squad: "100% dynamic backlog prioritization",
    maintenance: "Reserved monthly hours for bug fixes & updates",
    discovery: "Open-ended technical discussion",
  },
  {
    parameter: "Direct Communication",
    fixedScope: "Shared Slack channel + weekly sprint review",
    squad: "Direct integration into your Slack/Teams + daily async",
    maintenance: "Dedicated monitoring alerts & ticket portal",
    discovery: "Google Meet / Cal.com video call",
  },
  {
    parameter: "Code & IP Ownership",
    fixedScope: "100% transferred upon milestone completion",
    squad: "100% committed directly to your private GitHub repo",
    maintenance: "100% remains in your repository",
    discovery: "Mutual NDA signed before consultation",
  },
  {
    parameter: "Post-Launch Warranty",
    fixedScope: "30-day full bug-fixing warranty included",
    squad: "Continuous ongoing QA & regression testing",
    maintenance: "Continuous SLA & uptime guarantee",
    discovery: "Written architectural recommendation summary",
  },
  {
    parameter: "Billing Model",
    fixedScope: "Milestone-based (Kickoff, Alpha, Production)",
    squad: "Predictable monthly sprint retainer",
    maintenance: "Predictable monthly SLA subscription",
    discovery: "Free ($0) with zero obligation",
  },
];
---

<section class="py-5" style="background-color: var(--vesharo-navy-base, #070B14);">
  <div class="container py-4">
    <div class="row justify-content-center text-center mb-5">
      <div class="col-lg-8">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(0, 210, 255, 0.1); border: 1px solid rgba(0, 210, 255, 0.25);">
          <i class="ph ph-table text-cyan" style="color: var(--vesharo-electric-accent, #00d2ff);"></i>
          <span class="tz-text-xs text-uppercase fw-semibold tracking-wider text-cyan" style="color: var(--vesharo-electric-accent, #00d2ff); letter-spacing: 0.08em;">
            Model Comparison
          </span>
        </div>
        <h2 class="tz-display-2 fw-bold text-white mb-3" style="font-family: var(--font-family-heading);">
          Compare Engagement Structures
        </h2>
        <p class="tz-text-l text-neutral-400 mx-auto" style="max-width: 680px; color: #94A3B8;">
          Review the core differences in team allocation, delivery cycles, and billing models side by side.
        </p>
      </div>
    </div>

    <!-- Responsive, Accessible Comparison Table -->
    <div
      class="table-responsive rounded-3 p-1 p-md-3"
      style="background: rgba(11, 15, 25, 0.9); border: 1px solid rgba(255, 255, 255, 0.08);"
      tabindex="0"
      role="region"
      aria-label="Engagement Models Comparison Table"
    >
      <table class="table table-dark table-hover align-middle mb-0" style="--bs-table-bg: transparent; --bs-table-hover-bg: rgba(255, 255, 255, 0.03);">
        <thead>
          <tr style="border-bottom: 2px solid rgba(255, 255, 255, 0.12);">
            <th scope="col" class="py-3 px-3 text-white fw-bold fs-6" style="width: 20%; font-family: var(--font-family-heading);">
              Feature / Dimension
            </th>
            <th scope="col" class="py-3 px-3 text-white fw-bold fs-6" style="width: 20%; font-family: var(--font-family-heading);">
              Fixed-Scope Project
            </th>
            <th scope="col" class="py-3 px-3 fw-bold fs-6" style="width: 20%; font-family: var(--font-family-heading); color: var(--vesharo-electric-accent, #00d2ff);">
              Dedicated Squad <span class="badge bg-primary text-white rounded-pill ms-1" style="font-size: 0.65rem;">Popular</span>
            </th>
            <th scope="col" class="py-3 px-3 text-white fw-bold fs-6" style="width: 20%; font-family: var(--font-family-heading);">
              Maintenance Retainer
            </th>
            <th scope="col" class="py-3 px-3 text-white fw-bold fs-6" style="width: 20%; font-family: var(--font-family-heading);">
              Free Discovery Call
            </th>
          </tr>
        </thead>
        <tbody>
          {comparisonRows.map((row) => (
            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
              <th scope="row" class="py-3 px-3 text-white fw-semibold tz-text-s">
                {row.parameter}
              </th>
              <td class="py-3 px-3 text-neutral-300 tz-text-s" style="color: #CBD5E1;">
                {row.fixedScope}
              </td>
              <td class="py-3 px-3 fw-medium tz-text-s" style="color: #E0F2FE; background: rgba(0, 102, 255, 0.04);">
                {row.squad}
              </td>
              <td class="py-3 px-3 text-neutral-300 tz-text-s" style="color: #CBD5E1;">
                {row.maintenance}
              </td>
              <td class="py-3 px-3 text-neutral-300 tz-text-s" style="color: #CBD5E1;">
                {row.discovery}
              </td>
            </tr>
          ))}
          <!-- CTA Row -->
          <tr>
            <th scope="row" class="py-3 px-3 text-white fw-semibold tz-text-s">
              Next Step
            </th>
            <td class="py-3 px-3">
              <a href="/contact" class="btn btn-sm btn-outline-light tz-text-xs w-100">
                Get Scope Estimate
              </a>
            </td>
            <td class="py-3 px-3" style="background: rgba(0, 102, 255, 0.04);">
              <a href="/contact" class="btn btn-sm btn-primary tz-text-xs w-100" style="background: #0066FF; border-color: #0066FF;">
                Hire Squad
              </a>
            </td>
            <td class="py-3 px-3">
              <a href="/contact" class="btn btn-sm btn-outline-light tz-text-xs w-100">
                Protect App
              </a>
            </td>
            <td class="py-3 px-3">
              <a href="https://cal.com/vesharo/15min" class="btn btn-sm btn-outline-info tz-text-xs w-100" style="color: var(--vesharo-electric-accent, #00d2ff); border-color: var(--vesharo-electric-accent, #00d2ff);">
                Book 15-Min Call
              </a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="text-center mt-3">
      <span class="tz-text-xs text-muted" style="color: #64748B;">
        <i class="ph ph-info me-1"></i> Scroll horizontally on mobile devices to view all models.
      </span>
    </div>
  </div>
</section>
