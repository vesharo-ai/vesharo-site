---
/**
 * EngagementModelsTeaser.astro — Homepage teaser for transparent engagement models
 * Links directly to /pricing with clear, transparent structures.
 */
---

<section class="py-5" style="background-color: #070B14; border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
  <div class="container py-lg-4">
    <!-- Section Header -->
    <div class="row justify-content-center text-center mb-5">
      <div class="col-lg-8">
        <span class="d-inline-block px-3 py-1 rounded-pill small fw-medium mb-3" style="background: rgba(0, 102, 255, 0.1); color: #00D2FF; border: 1px solid rgba(0, 210, 255, 0.2); font-size: 0.8rem;">
          Engagement Models
        </span>
        <h2 class="display-6 fw-bold text-white mb-3" style="letter-spacing: -0.02em;">
          Transparent collaboration models for startups
        </h2>
        <p class="lead text-white-50 fs-6 mb-0" style="max-width: 620px; margin: 0 auto; line-height: 1.6;">
          Choose the engagement structure that aligns with your timeline, budget predictability, and product roadmap.
        </p>
      </div>
    </div>

    <!-- 3 Model Cards -->
    <div class="row g-4 mb-4">
      <!-- Model 1 -->
      <div class="col-lg-4">
        <div class="h-100 p-4 rounded-4 d-flex flex-column" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.07);">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="badge" style="background: rgba(0, 102, 255, 0.15); color: #00D2FF; font-weight: 600; font-size: 0.75rem; padding: 4px 10px;">
              Fixed Scope
            </span>
            <span class="text-white-50 small">Fast Time-to-Market</span>
          </div>
          <h3 class="h5 fw-bold text-white mb-2">MVP & Project Sprint</h3>
          <p class="text-white-50 small mb-4" style="line-height: 1.5;">
            Best for startups needing a clearly defined mobile app or software MVP delivered on a guaranteed schedule with fixed milestone pricing.
          </p>
          <ul class="list-unstyled d-flex flex-column gap-2 text-white-50 small mb-4 mt-auto">
            <li class="d-flex align-items-center gap-2">
              <i class="ph ph-check text-primary"></i>
              <span class="text-white">Detailed specification & wireframe alignment</span>
            </li>
            <li class="d-flex align-items-center gap-2">
              <i class="ph ph-check text-primary"></i>
              <span class="text-white">Bi-weekly milestone demonstrations</span>
            </li>
            <li class="d-flex align-items-center gap-2">
              <i class="ph ph-check text-primary"></i>
              <span class="text-white">Production deployment & 30-day warranty</span>
            </li>
          </ul>
          <a href="/pricing#engagement-models" class="btn btn-outline-light btn-sm rounded-pill py-2 w-100 fw-medium" style="border-color: rgba(255, 255, 255, 0.15);">
            Explore Sprint Scope
          </a>
        </div>
      </div>

      <!-- Model 2 -->
      <div class="col-lg-4">
        <div class="h-100 p-4 rounded-4 d-flex flex-column position-relative" style="background: rgba(0, 102, 255, 0.04); border: 1px solid rgba(0, 102, 255, 0.25);">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="badge" style="background: #0066FF; color: #ffffff; font-weight: 600; font-size: 0.75rem; padding: 4px 10px;">
              Most Popular
            </span>
            <span class="text-white-50 small">Continuous Delivery</span>
          </div>
          <h3 class="h5 fw-bold text-white mb-2">Dedicated Engineering Pod</h3>
          <p class="text-white-50 small mb-4" style="line-height: 1.5;">
            A full-stack squad of senior mobile and backend engineers integrated directly into your Slack and daily standups.
          </p>
          <ul class="list-unstyled d-flex flex-column gap-2 text-white-50 small mb-4 mt-auto">
            <li class="d-flex align-items-center gap-2">
              <i class="ph ph-check text-primary"></i>
              <span class="text-white">Full-time mobile + backend + QA engineers</span>
            </li>
            <li class="d-flex align-items-center gap-2">
              <i class="ph ph-check text-primary"></i>
              <span class="text-white">Direct communication with no middle management</span>
            </li>
            <li class="d-flex align-items-center gap-2">
              <i class="ph ph-check text-primary"></i>
              <span class="text-white">Flexible monthly scaling as roadmap evolves</span>
            </li>
          </ul>
          <a href="/pricing#engagement-models" class="btn btn-primary btn-sm rounded-pill py-2 w-100 fw-medium">
            Explore Pod Model
          </a>
        </div>
      </div>

      <!-- Model 3 -->
      <div class="col-lg-4">
        <div class="h-100 p-4 rounded-4 d-flex flex-column" style="background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.07);">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="badge" style="background: rgba(255, 255, 255, 0.05); color: #cbd5e1; font-weight: 600; font-size: 0.75rem; padding: 4px 10px;">
              Advisory
            </span>
            <span class="text-white-50 small">Architecture & Review</span>
          </div>
          <h3 class="h5 fw-bold text-white mb-2">Fractional Technical Lead</h3>
          <p class="text-white-50 small mb-4" style="line-height: 1.5;">
            Senior architecture guidance, code audits, cloud infrastructure optimization, and technical decision support for founders.
          </p>
          <ul class="list-unstyled d-flex flex-column gap-2 text-white-50 small mb-4 mt-auto">
            <li class="d-flex align-items-center gap-2">
              <i class="ph ph-check text-primary"></i>
              <span class="text-white">System architecture & mobile stack validation</span>
            </li>
            <li class="d-flex align-items-center gap-2">
              <i class="ph ph-check text-primary"></i>
              <span class="text-white">Codebase audits & security compliance reviews</span>
            </li>
            <li class="d-flex align-items-center gap-2">
              <i class="ph ph-check text-primary"></i>
              <span class="text-white">Hiring & technical interview assistance</span>
            </li>
          </ul>
          <a href="/pricing#engagement-models" class="btn btn-outline-light btn-sm rounded-pill py-2 w-100 fw-medium" style="border-color: rgba(255, 255, 255, 0.15);">
            Explore Advisory
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom link to full pricing page -->
    <div class="text-center mt-4">
      <a href="/pricing" class="d-inline-flex align-items-center gap-2 text-white-50 text-decoration-none small hover-text-white">
        <span>View detailed rate cards, estimation framework, and FAQ</span>
        <i class="ph ph-arrow-right text-primary"></i>
      </a>
    </div>
  </div>
</section>
