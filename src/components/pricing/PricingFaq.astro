---
import { getCollection } from "astro:content";

const allFaqs = await getCollection("faq");
const pricingFaqs = allFaqs
  .filter((f) => f.data.category === "Pricing & Payments" || f.data.category === "Support & Ownership")
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="py-5" style="background-color: var(--vesharo-navy-dark, #0B0F19);">
  <div class="container py-4">
    <div class="row justify-content-center text-center mb-5">
      <div class="col-lg-8">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(0, 102, 255, 0.1); border: 1px solid rgba(0, 102, 255, 0.25);">
          <i class="ph ph-currency-circle-dollar text-primary" style="color: #60A5FA;"></i>
          <span class="tz-text-xs text-uppercase fw-semibold tracking-wider" style="color: #60A5FA; letter-spacing: 0.08em;">
            Pricing & Commercial FAQs
          </span>
        </div>
        <h2 class="tz-display-2 fw-bold text-white mb-3" style="font-family: var(--font-family-heading);">
          Common Questions About Pricing & Contracts
        </h2>
        <p class="tz-text-l text-neutral-400 mx-auto" style="max-width: 680px; color: #94A3B8;">
          Clear, transparent details about payment milestones, cloud infrastructure billing, code ownership, and non-disclosure agreements.
        </p>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="d-flex flex-column gap-3">
          {pricingFaqs.map((faq, index) => (
            <details
              class="pricing-faq-item p-3 p-md-4 rounded-3"
              style="background: rgba(17, 24, 39, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);"
              open={index === 0}
            >
              <summary
                class="d-flex align-items-center justify-content-between fw-semibold text-white cursor-pointer"
                style="list-style: none; font-size: 1.05rem;"
              >
                <span class="d-flex align-items-start gap-2 pe-3">
                  <span style="color: var(--vesharo-electric-accent, #00d2ff); font-weight: bold;">Q.</span>
                  <span>{faq.data.question}</span>
                </span>
                <i class="ph ph-caret-down text-cyan ms-2" style="color: var(--vesharo-electric-accent, #00d2ff); transition: transform 0.2s ease;"></i>
              </summary>
              <div class="pt-3 mt-3 border-top" style="border-color: rgba(255, 255, 255, 0.06) !important;">
                <p class="mb-0 tz-text-m" style="color: #CBD5E1; line-height: 1.7;">
                  {faq.data.answer}
                </p>
              </div>
            </details>
          ))}
        </div>

        <div class="text-center mt-5">
          <p class="tz-text-m text-neutral-400 mb-3" style="color: #94A3B8;">
            Have questions about a custom technical setup or specific contract terms?
          </p>
          <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="https://cal.com/vesharo/discovery" class="btn btn-primary px-4 py-2 fw-semibold" style="background: #0066FF; border-color: #0066FF;">
              <i class="ph ph-calendar-plus me-2"></i> Book 30-Min Discovery Call
            </a>
            <a href="/faq" class="btn btn-outline-light px-4 py-2 fw-semibold">
              <i class="ph ph-arrow-right me-2"></i> View All Engineering FAQs
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary i {
    transform: rotate(180deg);
  }
  details[open] {
    border-color: rgba(0, 210, 255, 0.25) !important;
  }
</style>
