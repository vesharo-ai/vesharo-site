---
import SectionSubtitle from "@/components/section-subtitle/SectionSubtitle.astro";
import SectionTitle from "@/components/section-title/SectionTitle.astro";
---

<section class="tz-about1">
  <img
    src="/images/about/about1-shape2.svg"
    class="tz-about1__shape2"
    alt=""
    aria-hidden="true"
  />
  <div class="container">
    <div class="row g-4 d-flex justify-content-between">
      <div class="col-xl-5">
        <img src="/images/about/about1-img.jpg" alt="About Vesharo" class="img-fluid w-100 rounded" />
      </div>
      <div class="col-xl-6">
        <div class="tz-section-top text-start">
          <SectionSubtitle subtitle="About Vesharo" />
          <SectionTitle title="Engineered for Performance & Scale" />
          <div class="tz-section-title tz-display-2 text-uppercase fw-light">
            IT Services &amp; AI Automation
          </div>
        </div>
        <div class="row g-4 d-flex justify-content-between tz-pt-10 tz-pt-lg-20">
          <div class="col-md-5">
            <div class="tz-about1-experience tz-text-neutral5">
              <div class="tz-about1-experience__counter">
                <h5 class="tz-about1-experience__counter-number tz-cn">
                  7
                </h5>
                <span class="tz-about1-experience__counter-plus">
                  +
                </span>
              </div>
              <div class="tz-about1-experience__text text-uppercase">
                Core Tech Capabilities
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="tz-about1-content">
              <p class="tz-about1-desc tz-text-l tz-text-neutral6">
                Vesharo is an IT services and AI automation company delivering custom software, intelligent agents, mobile solutions, and resilient cloud architectures. We build technology that powers real businesses.
              </p>
              <div class="tz-buttons">
                <a
                  href="/about"
                  class="tz-button text-uppercase fw-medium tz-text-m"
                >
                  Explore More
                </a>
                <a href="/about" class="tz-button-circle" aria-label="Explore About Page">
                  <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <img
    src="/images/about/about1-shape.svg"
    class="tz-about1__shape floating"
    alt=""
    aria-hidden="true"
  />
</section>
