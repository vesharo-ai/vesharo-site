---
import SectionSubtitle from "@/components/section-subtitle/SectionSubtitle.astro";
import SectionTitle from "@/components/section-title/SectionTitle.astro";
---

<section class="tz-about2">
  <div class="container">
    <div class="row g-4">
      <div class="col-xl-9">
        <div class="row g-4">
          <div class="col-md-9">
            <div class="tz-section-top">
              <SectionSubtitle subtitle="ABOUT VESHARO" />
              <SectionTitle title="Our Engineering Philosophy" />
              <p class="tz-about2__desc tz-text-l tz-text-neutral6 fw-light">
                We combine architectural rigor with rapid execution to build software systems and AI agents that businesses rely on every single day.
              </p>
            </div>
          </div>
        </div>
        <div class="row g-4">
          <div class="col-md-5">
            <img src="/images/about/about2-img1.jpg" alt="Vesharo Engineering Lab" class="rounded" />
          </div>
          <div class="col-md-7">
            <div class="tz-about2-content">
              <div class="tz-about2__title text-uppercase tz-display-3 tz-text-neutral5 lh-1 tz-pb-10">
                AI Automation &amp; Custom Software
              </div>
              <p class="tz-about2__desc tz-text-l tz-text-neutral6 fw-light">
                At Vesharo, we don't build throwaway prototypes or generic templates. We architect end-to-end systems: enterprise device management platforms, high-throughput event engines, and autonomous AI automation.
              </p>
              <div class="row g-2 tz-pt-30 tz-pt-lg-60 tz-pb-20 tz-pb-lg-40">
                <div class="col-md-6">
                  <h4 class="tz-about2__subtitle tz-text-neutral5 fw-semibold">
                    100% IP Ownership
                  </h4>
                  <p class="tz-about2__desc tz-text-m tz-text-neutral6 fw-light">
                    Every line of code, infrastructure template, and architecture belongs entirely to you upon milestone completion.
                  </p>
                </div>
                <div class="col-md-6">
                  <h4 class="tz-about2__subtitle tz-text-neutral5 fw-semibold">
                    Sub-Second Performance
                  </h4>
                  <p class="tz-about2__desc tz-text-m tz-text-neutral6 fw-light">
                    We engineer for speed: static edge delivery, minimal client JavaScript, and optimized database queries.
                  </p>
                </div>
              </div>
              <div class="tz-buttons">
                <a
                  href="/portfolio-details"
                  class="tz-button text-uppercase fw-medium tz-text-m"
                >
                  Our Portfolio
                </a>
                <a class="tz-button-circle" href="/portfolio-details" aria-label="Our Portfolio">
                  <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-xl-3">
        <div class="tz-about2-experience">
          <img src="/images/about/about2-img2.jpg" alt="Vesharo Leadership" class="rounded" />
          <div class="tz-about2-experience__counter tz-text-neutral5 tz-pt-30 tz-pt-lg-60">
            <h5 class="tz-about2-experience__number tz-cn">
              7
            </h5>
            <span class="tz-about2-experience__plus">+</span>
          </div>
          <p class="tz-about2-experience__text tz-text-l tz-text-neutral5 text-uppercase">
            CORE CAPABILITIES
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
