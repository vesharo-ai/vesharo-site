---
/**
 * Analytics & Conversion Tracking.
 *
 * Supports:
 * 1. Cloudflare Web Analytics (free, privacy-preserving, cookie-free) via PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN
 * 2. Google Analytics 4 (GA4) via PUBLIC_GA_MEASUREMENT_ID
 * 3. Client-side interaction listeners tracking Call clicks, WhatsApp clicks, and Quote submissions.
 *
 * Renders nothing if neither token is configured, preserving speed and privacy.
 */
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const cfToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;

const isGaValid = /^G-[A-Z0-9]{6,12}$/i.test(measurementId ?? "");
const isCfValid = Boolean(cfToken && cfToken.trim().length > 10);
---

{
  isGaValid && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
      />
      <script is:inline define:vars={{ measurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", measurementId, {
          anonymize_ip: true,
        });
      </script>
    </>
  )
}

{
  isCfValid && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: cfToken.trim() })}
    />
  )
}

{/* Event tracker for conversions: Phone calls, WhatsApp clicks, and form submissions */}
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Track clicks on phone and WhatsApp links
    document.addEventListener("click", (e) => {
      const target = e.target.closest("a");
      if (!target) return;

      const href = target.getAttribute("href") || "";

      if (href.startsWith("tel:")) {
        if (typeof window.gtag === "function") {
          window.gtag("event", "contact_click", {
            event_category: "engagement",
            event_label: "phone_call",
            value: href,
          });
        }
      } else if (href.includes("wa.me") || href.includes("api.whatsapp.com")) {
        if (typeof window.gtag === "function") {
          window.gtag("event", "contact_click", {
            event_category: "engagement",
            event_label: "whatsapp_chat",
            value: href,
          });
        }
      }
    });
  });
</script>