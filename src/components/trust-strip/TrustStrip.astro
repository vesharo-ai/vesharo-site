---
import { getCollection } from "astro:content";

const clients = await getCollection("clients");
---

{clients.length > 0 && (
  <section class="py-4 border-top border-bottom border-secondary border-opacity-10" style="background-color: #070B14;">
    <div class="container">
      <div class="row align-items-center g-3">
        <div class="col-lg-3 text-center text-lg-start">
          <span class="text-uppercase tracking-wider fw-bold small text-white-50" style="letter-spacing: 0.1em; font-size: 0.75rem;">
            PROVEN IN PRODUCTION ACROSS
          </span>
        </div>
        <div class="col-lg-9">
          <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-between gap-3">
            {clients.map(({ data }) => (
              <div class="p-2 px-3 rounded-3 d-flex align-items-center gap-2" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06);">
                <i class="ph ph-check-circle text-primary" style="font-size: 1rem;"></i>
                <div>
                  <span class="text-white small fw-bold d-block">{data.name}</span>
                  <span class="text-white-50" style="font-size: 0.75rem;">{data.category}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
)}
