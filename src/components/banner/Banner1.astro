---
// Astro-Native Hero Banner — Zero Hydration JS
---

<section class="tz-banner1">
  <div class="container">
    <img
      src="/images/banner/banner1-gradient-left.png"
      alt=""
      aria-hidden="true"
      class="position-absolute bottom-0 start-0"
    />
    <img
      src="/images/banner/banner1-gradient-right.png"
      alt=""
      aria-hidden="true"
      class="position-absolute top-0 end-0"
    />
    <img
      src="/images/banner/banner1-shape1.png"
      alt=""
      aria-hidden="true"
      class="tz-banner1__shape1"
    />
    <img
      src="/images/banner/banner1-shape2.svg"
      alt=""
      aria-hidden="true"
      class="tz-banner1__shape2 floating"
    />
    <div class="row g-4 d-flex justify-content-between">
      <div class="col-xl-5">
        <span class="tz-banner1__title1 text-uppercase tz-text-neutral5 d-block">
          INTELLIGENT
        </span>
        <h1 class="tz-banner1__title2 text-uppercase tz-text-secondary">
          AI &amp; SOFTWARE
        </h1>
        <div class="tz-banner1-content">
          <p class="tz-banner1__desc tz-text-l tz-text-neutral6 tz-pb-xl-30">
            Vesharo delivers production-grade AI automation, custom software, and scalable cloud platforms engineered for reliability and speed.
          </p>
          <div class="tz-buttons">
            <a
              href="/portfolio-details"
              class="tz-button text-uppercase fw-medium tz-text-m"
            >
              Our Portfolio
            </a>
            <a href="/portfolio-details" class="tz-button-circle" aria-label="View Portfolio">
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
      <div class="col-xl-6">
        <div class="tz-banner1-info">
          <div class="tz-banner1-content2">
            <p class="tz-banner1__desc tz-text-l tz-text-neutral6">
              From enterprise device platforms to autonomous AI agents, we engineer bespoke technology that scales.
            </p>
          </div>
          <div class="tz-banner1-highlight">
            <div class="d-flex align-items-center gap-2">
              <i class="ph ph-shield-check" style="font-size: 24px; color: var(--vesharo-electric-accent, #00d2ff);" aria-hidden="true"></i>
              <span class="tz-text-neutral5 tz-text-m fw-semibold">
                100% Client-Owned IP
              </span>
            </div>
            <p class="tz-banner1-highlight__text tz-text-m tz-text-primary mt-1 mb-0">
              Enterprise-grade engineering standards
            </p>
          </div>
        </div>
        <div class="tz-banner1__wrapper">
          <img
            src="/images/banner/banner1-img.jpg"
            alt="Vesharo Engineering Showcase"
            class="tz-banner1__image img-fluid w-100"
          />
          <a href="/contact" class="tz-banner1__circle" aria-label="Start a Project">
            <img
              src="/images/banner/round-text.png"
              alt=""
              aria-hidden="true"
              class="tz-banner1__circle-img"
            />
            <div class="tz-banner1__circle-thumb">
              <span class="tz-banner1__circle-icon">
                <i class="ph ph-arrow-down" aria-hidden="true"></i>
              </span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
