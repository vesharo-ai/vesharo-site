---
// Vesharo Hero Banner — Premium, Responsive, Collision-Free
---

<section class="tz-banner1 position-relative overflow-hidden">
  <!-- Subtle ambient glow in brand colors -->
  <div class="hero-glow-left"></div>
  <div class="hero-glow-right"></div>

  <div class="container position-relative py-3 py-lg-4" style="z-index: 2;">
    <div class="row g-4 g-xl-5 align-items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="col-lg-6">
        <div class="hero-badge d-inline-flex align-items-center gap-2 mb-3 px-3 py-2 rounded-pill">
          <span class="pulse-dot"></span>
          <span class="fw-semibold" style="font-size: 13px; color: #00d2ff;">
            Mobile App Development First · React Native &amp; Expo
          </span>
        </div>

        <h1 class="hero-title fw-bold text-white mb-3" style="font-family: var(--font-family-heading);">
          We ship production mobile apps and software for startups.
        </h1>

        <p class="hero-subtitle mb-4" style="color: #cbd5e1; line-height: 1.65;">
          Cross-platform iOS and Android apps built with React Native and Expo. High-performance backends, release pipelines, and autonomous AI automation — delivered with senior engineering discipline.
        </p>

        <div class="d-flex flex-wrap align-items-center gap-3 mb-4 pb-2">
          <a
            href="https://cal.com/vesharo/15min"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary px-4 py-3 rounded-pill fw-semibold d-inline-flex align-items-center gap-2"
            style="background: #0066FF; border-color: #0066FF; font-size: 15px;"
            data-analytics-event="book_call_click"
            data-analytics-label="hero_cta_primary"
          >
            <span>Book a 15-minute call</span>
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>

          <a
            href="/portfolio"
            class="btn btn-outline-light px-4 py-3 rounded-pill fw-semibold d-inline-flex align-items-center gap-2"
            style="border-color: rgba(255, 255, 255, 0.2); font-size: 15px;"
          >
            <span>See what we've shipped</span>
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <!-- Verified Trust Points -->
        <div class="d-flex flex-wrap align-items-center gap-3 gap-md-4 pt-3 border-top border-secondary border-opacity-25">
          <div class="d-flex align-items-center gap-2">
            <i class="ph ph-shield-check" style="font-size: 20px; color: #00d2ff;" aria-hidden="true"></i>
            <span class="text-white" style="font-size: 13px; font-weight: 500;">100% Client-Owned IP</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <i class="ph ph-users" style="font-size: 20px; color: #00d2ff;" aria-hidden="true"></i>
            <span class="text-white" style="font-size: 13px; font-weight: 500;">Direct Senior Engineers</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <i class="ph ph-lightning" style="font-size: 20px; color: #00d2ff;" aria-hidden="true"></i>
            <span class="text-white" style="font-size: 13px; font-weight: 500;">2-Week Delivery Sprints</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Real Shipped Product UI in Device Frame -->
      <div class="col-lg-6 position-relative">
        <div class="hero-image-card hero-visual-frame p-2 rounded-4 position-relative">
          <img
            src="/images/project/lockapp-mockup.svg"
            alt="LockApp Android Enterprise MDM product screen mockup engineered by Vesharo"
            class="img-fluid rounded-4 w-100 shadow-lg"
            width="600"
            height="375"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            style="border: 1px solid rgba(0, 102, 255, 0.3); display: block;"
          />
          <div class="floating-stat-badge p-3 rounded-3 position-absolute shadow">
            <div class="d-flex align-items-center gap-2">
              <i class="ph ph-device-mobile" style="font-size: 22px; color: var(--vesharo-electric-accent, #00d2ff);" aria-hidden="true"></i>
              <div>
                <div class="fw-bold text-white" style="font-size: 13px; line-height: 1.2;">Shipped Product: LockApp</div>
                <div class="text-white-50" style="font-size: 11px;">Android Enterprise MDM &bull; React Native &amp; Kotlin</div>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-visual-reflection" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* The site header is position: fixed, so the hero reserves its height (~88px) at the top. */
  .tz-banner1 {
    padding: calc(88px + 1rem) 0 3rem;
  }

  @media (min-width: 992px) {
    .tz-banner1 {
      padding: calc(88px + 3rem) 0 5rem;
    }
  }

  .hero-glow-left {
    position: absolute;
    top: -100px;
    left: -150px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 102, 255, 0.15) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-glow-right {
    position: absolute;
    bottom: -100px;
    right: -150px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 210, 255, 0.12) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-badge {
    background: rgba(0, 102, 255, 0.1);
    border: 1px solid rgba(0, 210, 255, 0.25);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #00d2ff;
    border-radius: 50%;
    box-shadow: 0 0 10px #00d2ff;
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 15px #00d2ff; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  .hero-title {
    font-size: clamp(2.2rem, 4.8vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    position: static !important;
  }

  .gradient-text {
    color: #00d2ff;
    -webkit-text-fill-color: #00d2ff;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    line-height: 1.6;
    max-width: 540px;
  }

  .hero-image-card {
    background: rgba(15, 22, 38, 0.7);
    border: 1px solid rgba(0, 102, 255, 0.2);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
  }

  .floating-stat-badge {
    bottom: 20px;
    left: 20px;
    background: rgba(7, 11, 20, 0.92);
    border: 1px solid rgba(0, 210, 255, 0.35);
    backdrop-filter: blur(12px);
  }

  @media (max-width: 767px) {
    .floating-stat-badge {
      position: static !important;
      margin-top: 12px;
    }
  }
</style>
