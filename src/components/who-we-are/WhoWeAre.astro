---
import SectionSubtitle from "@/components/section-subtitle/SectionSubtitle.astro";
import SectionTitle from "@/components/section-title/SectionTitle.astro";

interface Props {
  backgroundColor?: string;
}

const { backgroundColor = "#121212" } = Astro.props;

const pillars = [
  {
    value: "100%",
    label: "IP & Code Ownership",
    sub: "Full rights & repository handover on delivery",
  },
  {
    value: "7",
    label: "Core Specializations",
    sub: "AI, Custom Software, Cloud, DevOps, Mobile",
  },
  {
    value: "0",
    label: "Vendor Data Leakage",
    sub: "Private VPC & strict AI security guardrails",
  },
  {
    value: "2",
    label: "Week Agile Sprints",
    sub: "Continuous working software demonstration",
  },
];
---

<section
  class="tz-wwa1 tz-bg-neutral3 tz-pt-60 tz-pb-60 tz-pt-lg-120 tz-pb-lg-120"
  style={{ backgroundColor }}
>
  <div class="container">
    <div class="row g-4">
      <div class="col-xl-5">
        <div class="tz-section-top">
          <SectionSubtitle subtitle="Engineering Standards" />
          <SectionTitle title="HOW WE DELIVER VALUE" />
        </div>
        <p class="tz-text-l tz-text-neutral6 mb-4">
          We combine senior engineering discipline with state-of-the-art AI automation to deliver robust, scalable digital assets that generate tangible business outcomes.
        </p>
        <img src="/images/wwa/wwa1-img.jpg" alt="Vesharo Engineering Standards" class="img-fluid w-100 rounded" />
      </div>
      <div class="col-xl-7">
        <div class="row g-4">
          <div class="col-xl-4 col-md-6 d-none d-md-block">
            <div class="tz-wwa1-shape">
              <img src="/images/wwa/wwa1-shape.svg" alt="" aria-hidden="true" />
            </div>
          </div>
          {pillars.map((item) => (
            <div class="col-xl-4 col-md-6">
              <div class="tz-wwa1-card">
                <img
                  src="/images/wwa/wwa1-muted-trishape.svg"
                  alt=""
                  aria-hidden="true"
                  class="tz-wwa1-card__trishape-muted"
                />
                <img
                  src="/images/wwa/wwa1-active-trishape.svg"
                  alt=""
                  aria-hidden="true"
                  class="tz-wwa1-card__trishape-active"
                />
                <div class="tz-wwa1-experience tz-text-neutral5">
                  <div class="tz-wwa1-experience__counter">
                    <h5 class="tz-wwa1-experience__counter-number tz-cn">
                      {item.value}
                    </h5>
                  </div>
                  <div class="tz-wwa1-experience__text text-uppercase tz-text-m fw-semibold">
                    {item.label}
                  </div>
                  <p class="tz-text-xs text-muted mt-2 mb-0" style="line-height: 1.3;">
                    {item.sub}
                  </p>
                </div>
              </div>
            </div>
          ))}
          <div class="col-xl-4 col-md-6">
            <div class="tz-wwa1-card d-flex flex-column justify-content-center align-items-center text-center p-4">
              <span class="tz-text-s text-uppercase fw-semibold mb-2" style="color: var(--vesharo-electric-accent, #00d2ff);">
                Have a project?
              </span>
              <a
                href="/contact"
                class="tz-button text-uppercase fw-medium tz-text-s d-inline-block"
                style="padding: 10px 18px;"
              >
                Discuss Scope
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
