---
import SectionSubtitle from "@/components/section-subtitle/SectionSubtitle.astro";
import SectionTitle from "@/components/section-title/SectionTitle.astro";
import { getCollection } from "astro:content";

interface Props {
  backgroundColor?: string;
  limit?: number;
}

const { backgroundColor = "#0f1626", limit = 4 } = Astro.props;

const allServices = await getCollection("services");
const services = allServices
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, limit);

const romanNumerals = ["I", "II", "III", "IV", "V", "VI", "VII"];
---

<section class="tz-service1" style={{ backgroundColor }}>
  <div class="container">
    <div class="tz-section-top">
      <div class="row g-4 align-items-end">
        <div class="col-md-8">
          <SectionSubtitle subtitle="Core Capabilities" />
          <SectionTitle title="Engineered For Modern Business" />
        </div>
        <div class="col-md-4">
          <div class="tz-buttons d-flex justify-content-start justify-content-md-end">
            <a
              href="/service-details"
              class="tz-button text-uppercase fw-medium tz-text-m"
            >
              All Services
            </a>
            <a href="/service-details" class="tz-button-circle" aria-label="View All Services">
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      {services.map((svc, index) => (
        <div class="col-md-6 col-xl-3">
          <div class={`tz-service1-card ${index === 0 ? "active" : ""}`}>
            <a href="/service-details" class="text-white d-block text-decoration-none">
              <span class="tz-service1-card__number">{romanNumerals[index] || index + 1}</span>
              <div class="tz-service1-card__content">
                <div class="tz-service1-card__shape d-flex justify-content-center tz-mb-20 tz-mb-lg-40">
                  <div
                    class="d-flex align-items-center justify-content-center rounded-circle"
                    style="width: 56px; height: 56px; background: rgba(0, 210, 255, 0.15); color: #00d2ff;"
                  >
                    <i class={`ph ${svc.data.icon}`} style="font-size: 28px;" aria-hidden="true"></i>
                  </div>
                </div>
                <h3 class="tz-service1-card__title text-uppercase text-center text-white">
                  {svc.data.title}
                </h3>
                <p class="tz-service1-card__desc fw-medium tz-text-l text-center mb-0" style="color: #cbd5e1;">
                  {svc.data.shortDescription}
                </p>
                <div class="tz-service1-card__footer">
                  <div class="row align-items-center">
                    <div class="col-8">
                      <span class="mb-0 text-uppercase tz-text-s fw-semibold" style="color: #00d2ff;">
                        Explore Capability
                      </span>
                    </div>
                    <div class="col-4">
                      <div class="d-flex justify-content-end">
                        <i class="ph ph-arrow-up-right text-white" style="font-size: 18px;" aria-hidden="true"></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="tz-service1-card__circle"></div>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Accent surfaces (active, hover, keyboard focus) need dark text to stay readable. */
  :global(.tz-service1-card.active),
  :global(.tz-service1-card:hover),
  :global(.tz-service1-card:focus-within) {
    background-color: var(--vesharo-electric-accent);
  }

  :global(.tz-service1-card:focus-within .tz-service1-card__content) {
    visibility: visible;
    opacity: 1;
  }

  :global(.tz-service1-card:focus-within .tz-service1-card__number),
  :global(.tz-service1-card:focus-within .tz-service1-card__circle) {
    visibility: hidden;
  }

  :global(.tz-service1-card.active *),
  :global(.tz-service1-card:hover *),
  :global(.tz-service1-card:focus-within *) {
    color: #070b14 !important;
  }

  :global(.tz-service1-card.active .tz-service1-card__shape > div),
  :global(.tz-service1-card:hover .tz-service1-card__shape > div),
  :global(.tz-service1-card:focus-within .tz-service1-card__shape > div) {
    background: rgba(12, 12, 12, 0.1) !important;
  }

  :global(.tz-service1-card a:focus-visible) {
    outline: 2px solid #070b14;
    outline-offset: 4px;
  }

  @media (max-width: 991px) {
    :global(.tz-service1-card .tz-service1-card__content) {
      visibility: visible !important;
      opacity: 1 !important;
    }
    /* Content is always shown on touch layouts, so the hover-only decorations would cover it. */
    :global(.tz-service1-card .tz-service1-card__number),
    :global(.tz-service1-card .tz-service1-card__circle) {
      display: none !important;
    }
    :global(.tz-service1-card__footer) {
      padding-top: 1.5rem !important;
    }
    :global(.tz-service1-card) {
      padding: 1.75rem !important;
      min-height: auto !important;
    }
  }
</style>
