---
import { getCollection } from "astro:content";

interface Props {
  backgroundColor?: string;
  limit?: number;
}

const { backgroundColor = "#070B14", limit = 7 } = Astro.props;

const allServices = await getCollection("services");
const services = allServices
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, limit);
---

<section class="tz-service1 py-5" style={{ backgroundColor }}>
  <div class="container py-4">
    <!-- Section Top Header -->
    <div class="d-flex flex-wrap align-items-end justify-content-between mb-5 gap-3">
      <div>
        <div class="d-inline-flex align-items-center gap-2 mb-2 px-3 py-1 rounded-pill" style="background: rgba(0, 210, 255, 0.1); border: 1px solid rgba(0, 210, 255, 0.25);">
          <span style="width: 6px; height: 6px; border-radius: 50%; background-color: #00d2ff;"></span>
          <span class="fw-semibold" style="font-size: 13px; color: #00d2ff;">
            Core Capabilities
          </span>
        </div>
        <h2 class="h2 text-white fw-bold mb-0" style="font-family: var(--font-family-heading);">
          Engineering services for startups and growing teams
        </h2>
      </div>
      <div>
        <a href="/services" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
          View all 7 services
        </a>
      </div>
    </div>

    <!-- Always-Visible Responsive Service Cards Grid -->
    <div class="row g-4">
      {services.map((svc) => (
        <div class="col-md-6 col-lg-4">
          <a
            href={`/services/${svc.data.id}`}
            class="service-card-item p-4 rounded-4 d-flex flex-column justify-content-between text-decoration-none h-100 position-relative"
            style="background: #0B0F19; border: 1px solid rgba(255, 255, 255, 0.08); transition: border-color 0.2s ease, transform 0.2s ease;"
          >
            <div>
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div
                  class="d-inline-flex align-items-center justify-content-center rounded-3 p-2"
                  style="width: 48px; height: 48px; background: rgba(0, 102, 255, 0.15); color: #00d2ff;"
                >
                  <i class={`ph ${svc.data.icon}`} style="font-size: 24px;" aria-hidden="true"></i>
                </div>
                {svc.data.id === "mobile-app-development" && (
                  <span class="badge px-2 py-1 rounded" style="background: rgba(0, 210, 255, 0.15); color: #00d2ff; font-size: 11px;">
                    Flagship Offering
                  </span>
                )}
              </div>
              <h3 class="h5 text-white fw-bold mb-2" style="font-family: var(--font-family-heading);">
                {svc.data.title}
              </h3>
              <p class="small mb-4" style="line-height: 1.6; color: #cbd5e1;">
                {svc.data.shortDescription}
              </p>
            </div>
            <div class="d-flex align-items-center justify-content-between pt-3 border-top border-secondary border-opacity-15">
              <span class="small fw-semibold" style="color: #00d2ff;">
                Explore service details
              </span>
              <i class="ph ph-arrow-right text-white" style="font-size: 16px;" aria-hidden="true"></i>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .service-card-item:hover,
  .service-card-item:focus-visible {
    border-color: rgba(0, 210, 255, 0.5) !important;
    background: #0F1626 !important;
    outline: none;
  }

  .service-card-item:focus-visible {
    outline: 2px solid #00d2ff !important;
    outline-offset: 3px !important;
  }
</style>
