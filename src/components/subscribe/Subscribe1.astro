---
interface Props {
  spacingClass?: string;
  title?: string;
  subtitle?: string;
  buttonLabel?: string;
  buttonLink?: string;
}

const {
  spacingClass = "",
  title = "Ready to build software that ships?",
  subtitle = "Discuss your architecture directly with our senior technical leads. Free 15-minute call.",
  buttonLabel = "Book a 15-minute call",
  buttonLink = "https://cal.com/vesharo/15min",
} = Astro.props;
---

<div class={`tz-subscribe1 ${spacingClass}`}>
  <div class="container">
    <div class="tz-subscribe1__wrapper">
      <div class="row g-4 d-flex align-items-center justify-content-between">
        <div class="col-lg-7">
          <h2 class="tz-subscribe1__title tz-display-3 mb-2 text-white">
            {title}
          </h2>
          <p class="tz-text-l tz-text-neutral6 mb-0">
            {subtitle}
          </p>
        </div>
        <div class="col-lg-4 d-flex justify-content-lg-end justify-content-start">
          <div class="tz-buttons">
            <a
              href={buttonLink}
              class="tz-button fw-medium tz-text-m"
              target={buttonLink.startsWith("http") ? "_blank" : undefined}
              rel={buttonLink.startsWith("http") ? "noopener noreferrer" : undefined}
            >
              {buttonLabel}
            </a>
            <a
              href={buttonLink}
              class="tz-button-circle"
              aria-label={buttonLabel}
              target={buttonLink.startsWith("http") ? "_blank" : undefined}
              rel={buttonLink.startsWith("http") ? "noopener noreferrer" : undefined}
            >
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
