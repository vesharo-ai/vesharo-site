---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section
  class="tz-breadcrumb"
  style="background: linear-gradient(180deg, #070B14 0%, #0B0F19 100%); border-bottom: 1px solid rgba(255, 255, 255, 0.06);"
>
  <div class="container">
    <div class="row">
      <div class="col-md-6">
        <div class="tz-breadcrumb__content">
          <span class="tz-breadcrumb__title tz-display-4 tz-text-neutral5 text-uppercase d-block mb-3">
            {title}
          </span>
          <div class="tz-breadcrumb__menu tz-text-l text-uppercase">
            <nav aria-label="Breadcrumb">
              <ul class="tz-breadcrumb__list">
                <li class="tz-breadcrumb__item">
                  <a href="/">Home</a>
                </li>
                <li class="tz-breadcrumb__item active" aria-hidden="true">
                  <i class="ph ph-caret-double-right"></i>
                </li>
                <li
                  class="tz-breadcrumb__item active"
                  aria-current="page"
                >
                  {title}
                </li>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
